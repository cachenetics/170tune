#!/usr/bin/env bash
# 170tune - measure, qualify and recover clock/voltage settings on a CMP 170HX.
#
# Named to match a family of per-domain tuning suites.
#
# Built because the failure that matters on this card is not a crash. An overclock can complete
# every benchmark, throw no Xid, never hang, and silently return wrong bytes - intermittently.
# So this tool separates "it ran" from "it is safe", records what it was doing before a hang, and
# knows how to put the card back.
#
# Commands:
#   explain                        the SM clock/voltage levers, the two regimes, failure modes
#   explain-hbm                    the HBM memory levers: clock, timings, refresh, how they interact
#   status                         what the card is set to right now
#   try     <off> <clk> [secs]     apply and measure one point (UNVERIFIED - proves nothing)
#   gate    <off> <clk> [n] [--workload <cmd>]   the proof: n soaked full-VRAM sweeps + compute
#   ladder  <clk> [start] [step]   walk the offset up at one ceiling until it breaks, gating each step
#   qualify [clk]                  full per-card flow, writes results/<serial>/oc.json
#   apply   <profile> | reset      hand off to 170hx-oc (this boot only)
#   quarantine / unquarantine      record (or clear) a point as known-bad on THIS card
#   mclk-try / mclk-gate / mclk-ladder / hbm-matrix / timings / timings-gate / refresh
#                                   the HBM levers - see 'explain-hbm'
#   persist save/enable/disable/status   make a gated profile (SM and/or HBM) survive reboots
#   selftest                       prove the harness still detects a known-bad point
#   recover                        put the card back, escalating honestly if it is wedged
#   boot-check                     (systemd) revert if the last run never checked in
#   install [prefix]               build every helper tool from source, install (default /usr/local/bin)
#   preflight                      read-only checklist before tuning a new card/box
#   snapshot-stock                 read this card's current values, save them as its stock override
set -uo pipefail
# systemd runs boot-apply/boot-check with no HOME; under set -u the find_tool $HOME fallbacks
# below would abort with "HOME: unbound variable". Default it so those lines are harmless (the
# real tools resolve from /usr/local/bin first anyway).
: "${HOME:=/root}"

STATE=${STATE:-/var/lib/170tune}
# Paths must survive sudo, where $HOME becomes /root. Resolve against the INVOKING user's home.
user_home() { getent passwd "${SUDO_USER:-$(id -un)}" 2>/dev/null | cut -d: -f6; }
find_tool() { local p; for p in "$@"; do [ -x "$p" ] && { printf '%s' "$p"; return 0; }; done; printf '%s' "$1"; }
NVML=${NVML:-/usr/local/bin/nvml_oc}
OCEFF=${OCEFF:-$(find_tool /usr/local/bin/oc_eff "$(user_home)/170hx/tools/oc_eff" "$HOME/170hx/tools/oc_eff")}
# The integrity gate for SM qualify/gate. 170hx-sweep (shipped here) is the sweep on its own; a
# fuller bench harness that prints the same result line can be substituted with BENCH=.
BENCH=${BENCH:-$(find_tool /usr/local/bin/170hx-sweep "$(dirname "$(readlink -f "$0")")/170hx-sweep" \
                           /usr/local/bin/170hx-test.sh "$(user_home)/170hx/tools/170hx-test.sh" "$HOME/170hx/tools/170hx-test.sh")}
COMPUTE=${COMPUTE:-$(find_tool /usr/local/bin/compute_check "$(user_home)/170hx/tools/compute_check" "$HOME/170hx/tools/compute_check")}
# The context probe. A card that answers nvidia-smi and reads healthy clocks can still refuse
# every CUDA context - seen after a hard kill of an inference server mid-context. CTXPROBE is the
# only thing that actually asks the card to DO something instead of merely answering a query.
CTXPROBE=${CTXPROBE:-$(find_tool /usr/local/bin/ctx_probe "$(user_home)/170hx/tools/ctx_probe" "$HOME/170hx/tools/ctx_probe")}
CTX_TIMEOUT=${CTX_TIMEOUT:-60}  # a context probe that hangs is a wedge, not a pass
OCAPPLY=${OCAPPLY:-/usr/local/bin/170hx-oc}
# HBM levers - both are LIVE userspace BAR0 tools (no driver rebuild). hbm_mclk
# sets the FBPA PLL NDIV; fbpa_regs sets the DRAM CONFIG timings. The unlock
# opens the PLMs; these just poke BAR0, so 170tune owns the HBM OC end to end.
HBM_MCLK=${HBM_MCLK:-$(find_tool /usr/local/bin/hbm_mclk "$(user_home)/170hx/tools/hbm_mclk" "$HOME/170hx/tools/hbm_mclk")}
FBPA_REGS=${FBPA_REGS:-$(find_tool /usr/local/bin/fbpa_regs "$(user_home)/170hx/tools/fbpa_regs" "$HOME/170hx/tools/fbpa_regs")}
# The full-VRAM pattern sweep (emits MEM_ERRORS=/COMPUTE_OK=/BW_TRIAD_GBs=). 170tune calls it
# DIRECTLY and parses its native output - no shell wrapper (a wrapper using ~ broke under sudo).
SELFTEST=${SELFTEST:-$(find_tool /usr/local/bin/gpu_selftest "$(user_home)/170hx/tools/gpu_selftest" "$HOME/170hx/tools/gpu_selftest")}
STOCK_NDIV=${STOCK_NDIV:-64}                    # this card's VBIOS stock NDIV (1728 MHz); the revert target
STOCK_REFRESH=${STOCK_REFRESH:-6}               # stock CONFIG4 REFRESH field (~3.9us at 1728); refresh revert target
STOCK_WALL=${STOCK_WALL:-1769}                  # GB/s theoretical peak at stock NDIV - the >wall clock-moved anchor
TRIAD=${TRIAD:-$(find_tool /usr/local/bin/hbm_triad "$(user_home)/170hx/tools/hbm_triad" "$HOME/170hx/tools/hbm_triad")}
# hbm-matrix uses these two directly: nvidia_bench (--csv: read/write/copy/triad/d2d/lat) and
# mem_probe (the peak streaming read + dependent-load latency). Both are built by 'install'.
NVBENCH=${NVBENCH:-$(find_tool /usr/local/bin/nvidia_bench "$(user_home)/170hx/tools/nvidia_bench" "$HOME/170hx/tools/nvidia_bench")}
MEMPROBE=${MEMPROBE:-$(find_tool /usr/local/bin/mem_probe "$(user_home)/170hx/tools/mem_probe" "$HOME/170hx/tools/mem_probe")}
# hbm-matrix measures every OVERCLOCKED rung at the power-optimized ship refresh (field 24); the
# stock NDIV row stays at stock refresh so the baseline is honestly fully-stock. Override if needed.
HBM_MATRIX_REFRESH=${HBM_MATRIX_REFRESH:-24}
MEASURE_TIMEOUT=${MEASURE_TIMEOUT:-180}
GATE_TEMP=${GATE_TEMP:-60}      # soak until HBM reaches this many C - gate HOT, never cold
GATE_SOAK_MAX=${GATE_SOAK_MAX:-180}  # give up soaking after this many seconds
GATE_COMPUTE=${GATE_COMPUTE:-45} # seconds of bit-exact GEMM checking per gate
SWEEP_TIMEOUT=${SWEEP_TIMEOUT:-600}
WORKLOAD_TIMEOUT=${WORKLOAD_TIMEOUT:-900}  # 'gate --workload <cmd>': a workload that hangs is a FAIL
MCLK_GATE_SOAK_MAX=${MCLK_GATE_SOAK_MAX:-360}  # mclk rungs cool during the probe; give the soak longer
CORE_PIN_MHZ=${CORE_PIN_MHZ:-1410}             # (unused by default) core-lock clock for experiments
# The DDLL eye recal is OPT-IN. It can push NDIV past the bare ceiling (~70) but is
# NON-DETERMINISTIC and temperature-sensitive - it can also knock a good eye off-center
# (it destabilised bare-stable NDIV 70 in testing). Default OFF: the gate and persist use the
# robust BARE path. Set MCLK_RECAL=1 to explore the recal-extended range (not robust).
MCLK_RECAL=${MCLK_RECAL:-}
# This card's STOCK DRAM timing cycle counts (read at NDIV 64). The timing tune scales the command
# set from these to hold stock ns at a higher NDIV. Override per card if stock differs.
STOCK_TIMINGS=${STOCK_TIMINGS:-"RC:67 RFC:657 RAS:43 RP:24 RD_RCD:27 WR_RCD:18 WR:25 FAW:22 RRD:5 W2R_BUS:8 R2W_BUS:8"}
# MCLK_TUNE=1 makes mclk-gate/ladder apply the custom-timing profile per NDIV (command timings scaled
# to hold stock ns, + bus-turnaround 8->12 + CDLR 9->13). This is what extends the robust ceiling past
# the bare limit (measured 76 bare -> 77 tuned), deterministically, with no DDLL recal.
MCLK_TUNE=${MCLK_TUNE:-}
PERSIST=${PERSIST:-$STATE/persist}
PERSIST_UNIT=${PERSIST_UNIT:-/etc/systemd/system/170tune-persist.service}
# Both shipped 170HX SKUs: 8GB (0x20C2, 64GB unlock) and 10GB (0x2082, 40GB unlock). A 16GB ROM
# exists but was never shipped, so it is deliberately not matched here.
DEVID_170HX_PATTERNS="20c2 2082"

c_hi=$'\033[1m'; c_ok=$'\033[32m'; c_warn=$'\033[33m'; c_bad=$'\033[31m'; c_off=$'\033[0m'
[ -t 1 ] || { c_hi=""; c_ok=""; c_warn=""; c_bad=""; c_off=""; }
say() { printf '%s\n' "$*"; }
die() { printf '%s%s%s\n' "$c_bad" "$*" "$c_off" >&2; exit 1; }

SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
need_root() { [ "$(id -u)" -eq 0 ] || exec sudo -E "$0" "$@"; }
serial() { nvidia-smi --query-gpu=serial --format=csv,noheader 2>/dev/null | head -1 | tr -d ' '; }
devid()  { nvidia-smi --query-gpu=pci.device_id --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ' | tr 'A-Z' 'a-z'; }
xids()   { dmesg 2>/dev/null | grep -cE "Xid [0-9]|requires reset"; }

is_170hx() {
    local d p; d="$(devid)"
    for p in $DEVID_170HX_PATTERNS; do
        case "$d" in *"$p"*) return 0 ;; esac
    done
    return 1
}

wedged() {
    # a wedged GPU reports N/A for clocks and nvml_oc cannot read its offset
    local c; c=$(nvidia-smi --query-gpu=clocks.sm --format=csv,noheader 2>&1 | head -1)
    [[ "$c" == *"N/A"* || "$c" == *"Unable"* ]] && return 0
    "$NVML" 2>&1 | grep -qi "requires reset" && return 0
    return 1
}

# The wedge the checks above cannot see. After a hard kill of an inference server mid-context the
# card can answer nvidia-smi normally, report no "requires reset" and read healthy clocks while no
# process can create a CUDA context (torch: device_count()=1, is_available()=False). Measured on
# the reference card, where 'recover' printed "card responds - recovered" over exactly that state
# and the GPU stayed useless until the driver was reloaded by hand. Querying the card is not the
# same as using it, so ask it to run something.
#   0 = no context can be created (dead for every practical purpose)
#   1 = a context works, OR the card is merely out of memory, OR there is no probe to ask with
ctx_dead() {
    local rc
    if [ -x "$CTXPROBE" ]; then
        timeout "$CTX_TIMEOUT" "$CTXPROBE" >/dev/null 2>&1; rc=$?
    elif [ -x "$COMPUTE" ]; then
        # fallback for an install predating ctx_probe: a 1 s compute check needs a context too.
        # exit 1 there is a MISMATCH, not a context failure - the card is usable and wrong.
        timeout "$CTX_TIMEOUT" "$COMPUTE" 1 256 >/dev/null 2>&1; rc=$?
        [ "$rc" -eq 1 ] && return 1
    else
        return 1    # nothing to probe with: never claim a wedge we cannot demonstrate
    fi
    case "$rc" in
        0|3) return 1 ;;    # usable (3 = ctx_probe's out-of-memory: a server owns the VRAM)
        *)   return 0 ;;    # 2 = context refused, 124 = the probe hung. Both are wedged.
    esac
}

# ---------------------------------------------------------------- armed marker
# Written BEFORE a risky apply and cleared only after the run checks back in. If the box hangs,
# the marker survives the reboot and boot-check reports what killed it instead of losing it.
arm() {
    mkdir -p "$STATE"
    cat > "$STATE/armed.json" <<EOF
{"offset": $1, "ceiling": $2, "serial": "$(serial)", "started": "$(date -Is)", "boot_id": "$(cat /proc/sys/kernel/random/boot_id)"}
EOF
    sync
}
disarm() { rm -f "$STATE/armed.json"; }

# ---------------------------------------------------------------- gate receipts (SM)
# A receipt is written ONLY by a gate that passed, and it is per serial: it is the evidence
# 'persist save' demands before it will let an SM offset/ceiling point survive a reboot. Silicon
# varies card to card, so a receipt from another card proves nothing about this one and is
# deliberately not portable.
receipt_file() { printf '%s/gated/%s/off%s_clk%s.json' "$STATE" "$(serial)" "$1" "$2"; }
write_receipt() {
    local off=$1 clk=$2 n=$3 tmax=$4 wl=${5:-} f; f=$(receipt_file "$off" "$clk")
    mkdir -p "$(dirname "$f")"
    cat > "$f" <<EOF
{"serial": "$(serial)", "offset": $off, "ceiling": $clk, "mclk_mhz": $(mclk), "sweeps": $n, "peak_hbm_c": ${tmax:-0},
 "compute_check": $([ -x "$COMPUTE" ] && [ "$GATE_COMPUTE" -gt 0 ] && echo true || echo false),
 "workload": $([ -n "$wl" ] && printf '"%s"' "$(printf '%s' "$wl" | tr -d '"\\')" || echo null),
 "gated": "$(date -Is)"}
EOF
    sync
}

# ---------------------------------------------------------------- quarantine (SM)
# The negative half of the record, and the one the gate cannot produce on its own.
# A point can pass four hot sweeps and 56,688 bit-exact GEMMs and still fault within seconds of
# real work: measured on the reference card, balanced/perf/max all gated clean and all killed an
# sglang server mid-inference, one of them at CUDA graph capture with "an illegal instruction was
# encountered". The gate's instruction mix is narrower than an application's, so a PASS is
# necessary and not sufficient. When something is caught in service, record it here: persist
# refuses a quarantined point even when a passing receipt exists.
quarantine_file() { printf '%s/quarantine/%s/off%s_clk%s.json' "$STATE" "$(serial)" "$1" "$2"; }

cmd_quarantine() {
    need_root quarantine "$@"
    if [ "${1:-}" = "list" ]; then
        local d; d="$STATE/quarantine/$(serial)"
        [ -d "$d" ] || { say "no quarantined points on card $(serial)"; return 0; }
        say "${c_hi}quarantined on card $(serial):${c_off}"
        local f
        for f in "$d"/*.json; do [ -f "$f" ] || continue; sed 's/^/    /' "$f"; done
        return 0
    fi
    local off=${1:?usage: 170tune quarantine <off> <clk> --reason "..."} clk=${2:?ceiling}; shift 2
    local reason=""
    while [ $# -gt 0 ]; do
        case "$1" in --reason) reason=${2:-}; shift 2 ;; *) reason="$1"; shift ;; esac
    done
    [ -n "$reason" ] || die "a quarantine needs a reason - what did it do, and to what?"
    local f; f=$(quarantine_file "$off" "$clk"); mkdir -p "$(dirname "$f")"
    cat > "$f" <<EOF
{"serial": "$(serial)", "offset": $off, "ceiling": $clk,
 "reason": "$(printf '%s' "$reason" | tr -d '"\\')",
 "by": "${SUDO_USER:-$(id -un)}", "at": "$(date -Is)"}
EOF
    sync
    say "${c_warn}quarantined +$off/$clk on card $(serial)${c_off}"
    say "   persist will now refuse it even with a passing gate receipt (--force still overrides)"
    local live; live=$(cur_offset)
    [ "${live:-}" = "$off" ] && say "${c_bad}   NOTE: the card is running +$off RIGHT NOW - 170tune reset${c_off}"
    return 0
}

cmd_unquarantine() {
    need_root unquarantine "$@"
    local off=${1:?offset} clk=${2:?ceiling} f; f=$(quarantine_file "$off" "$clk")
    [ -f "$f" ] || die "+$off/$clk is not quarantined on this card"
    rm -f "$f"
    say "cleared the quarantine on +$off/$clk. Re-gate it before you trust it."
}

# ---------------------------------------------------------------- apply / read
apply_point() {
    local off=$1 clk=$2
    nvidia-smi -pm 1 >/dev/null 2>&1
    nvidia-smi -pl 300 >/dev/null 2>&1
    "$NVML" "$off" 0 >/dev/null 2>&1 || return 1
    nvidia-smi -lgc "210,$clk" >/dev/null 2>&1 || return 1
    return 0
}

# Drive the card under sustained load until it reaches a realistic operating temperature.
# Soaking for a fixed DURATION is not good enough: how hot the card gets in 60 s depends on
# ambient, on the profile, and on what ran before. Soak to a TEMPERATURE and report it.
# Soak against HBM temperature, not core. The core reaches 52 C in seconds while the stacks are
# still cold, and it is the MEMORY side that the pattern sweep is sensitive to: the run that first
# caught +325/1400 had been driven to 59 C HBM. Targeting core temperature passed that same point.
gpu_temp()  { nvidia-smi --query-gpu=temperature.memory --format=csv,noheader 2>/dev/null | tr -d ' '; }
core_temp() { nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null | tr -d ' '; }
soak_to_temp() {
    local target=${1:-$GATE_TEMP}
    local maxsecs=${2:-$GATE_SOAK_MAX}
    local end=$((SECONDS + maxsecs))
    local t
    t=$(gpu_temp)
    while [ "${t:-0}" -lt "$target" ] 2>/dev/null; do
        [ $SECONDS -ge $end ] && break
        timeout 60 "$OCEFF" 8 >/dev/null 2>&1 || break
        t=$(gpu_temp)
    done
    printf '%s' "${t:-0}"
}

# Live memory clock as the DRIVER reports it. Two very different things can move this number:
# a driver compiled with cmpunlocker --mclk-ndiv bakes a non-stock value into devinit, and nvidia-smi
# correctly reports it (the driver itself believes that is "current"). A LIVE userspace BAR0 write
# via hbm_mclk does NOT move this number - nvidia-smi is blind to it (measured, see mclk_verify) -
# so this function alone cannot see a live-tuned NDIV. See mclk_source() below, which combines this
# with hbm_mclk's own direct register read to tell the two apart.
mclk() { nvidia-smi --query-gpu=clocks.current.memory --format=csv,noheader,nounits 2>/dev/null \
         | head -1 | tr -d ' '; }

# nvml_oc prints the offset signed ("+350 MHz"). Strip the sign so this can be COMPARED with a
# profile's offset, not just displayed - 'persist save' checks the card actually took the setting.
cur_offset() { "$NVML" 2>/dev/null | awk '/current offset/{v=($NF=="MHz")?$(NF-1):$NF; sub(/^\+/,"",v); print v; exit}'; }

# ---------------------------------------------------------------- subcommands
cmd_explain() {
cat <<'EOF'
THE TWO LEVERS

  clock ceiling   nvidia-smi -lgc 210,<max>      picks the FREQUENCY the arbiter lands on
  VF offset       nvmlDeviceSetGpcClkVfOffset    picks the VOLTAGE that frequency gets

  You cannot set voltage directly on this SKU - there is no voltage API and no voltage
  telemetry. The offset shifts the whole voltage/frequency curve, so a positive offset means
  a given clock is reached at a LOWER voltage. Proven by holding the clock fixed and watching
  watts: at a pinned 1350 MHz, offset +0 to +300 took 174.6 W down to 132.0 W with identical
  throughput.

  Power is an OUTCOME, not an input. A -pl cap also works but lets the clock oscillate around
  the cap, which smears you across voltage points; pinning the clock holds one point and
  measures better. The ceiling is set as 210,<max> so the card still idles down.

TWO REGIMES

  Below about 1350 the rail bottoms out: power goes flat and extra offset is inert.
  Above about 1400 the data path runs out of voltage before the rail bottoms out.
  So the safe offset is a function of the clock, and the best efficiency point sits at the
  FLOOR of a lower ceiling rather than near the CLIFF of a higher one.

FOUR FAILURE MODES, IN ORDER OF NASTINESS

  1. SILENT CORRUPTION - the run completes, no Xid, no hang, and memory comes back wrong.
     Measured at +325/1400: sweeps gave 6 errors, 3 errors, 0 errors. This is why 'try' proves
     nothing and only 'gate' can call a point safe.
     AND IT IS TEMPERATURE DEPENDENT. That same point passed 4/4 sweeps on a cold card (37-43C)
     and then returned mem_errors=4 after a soak to 51C core / 59C HBM. Hot silicon needs more
     voltage, so an undervolt that is stable cold corrupts hot. 'gate' therefore soaks the card
     before every sweep (GATE_SOAK seconds, default 60) and warns if it never got hot.
  2. DEVICE FAULT - CUDA dies with illegal instruction / illegal memory access / cublas 14.
     Recoverable with 'recover', usually needs a driver reload.
  3. HANG - the GPU stops answering. Needs a reboot, sometimes a power cycle.
  4. CONTEXT WEDGE - nvidia-smi answers, clocks read fine, NVML says nothing is wrong, and
     no process can create a CUDA context (torch: device_count()=1, is_available()=False).
     Seen after hard kills of a server mid-context. 'status' and 'recover' probe for this
     by actually creating a context; do not trust a healthy-looking nvidia-smi here.

  Work going DOWN while the clock goes UP is a fifth signature worth knowing: past the wall
  the NAFLL stretches the clock instead of executing faster. +400/1650 reports a higher clock
  than +375/1650 and delivers 4% less.

HOW TO USE THIS TOOL

  170tune try 300 1350        measure a point (fast, unverified)
  170tune gate 300 1350 4     prove it with four full-VRAM pattern sweeps
  170tune ladder 1350         find this card's safe ceiling at one clock
  170tune qualify             the whole flow, recorded per serial
  170tune recover             put it back after a fault
EOF
}

cmd_explain_hbm() {
cat <<'EOF'
THE HBM MEMORY LEVERS - what they are and how they work together

  The clock/voltage levers ('explain') tune the SM. This tunes the memory. Same
  discipline: only 'gate' can call a point safe, and HBM's failure mode is the worst
  kind - a silent single-bit flip, not a crash. Everything here is live userspace
  BAR0 (the unlock opens the PLMs); no driver rebuild.

THE MASTER LEVER: THE MEMORY CLOCK (NDIV)

  The HBM has its own PLL. One integer, NDIV, sets the whole memory clock: stock
  NDIV 64 = 1728 MHz, each +1 = +27 MHz. Everything below is DERIVED from it. The
  bandwidth wall is NDIV x 27.648 GB/s; you land at 92-94% of it.
      170tune mclk-try  76      move it and measure   (UNVERIFIED)
      170tune mclk-gate 76 12   prove it, 12 hot sweeps
  The clock alone reaches NDIV 76 on stock timings. Past that, the timings bind.

  IMPORTANT - a driver compiled with cmpunlocker's --mclk-ndiv flag bakes a NON-STOCK
  memory clock into the driver itself. That is a DIFFERENT mechanism from the live
  userspace mclk-try/mclk-gate above, and 170tune cannot safely tune ON TOP of one: if
  nvidia-smi's own idea of "current" is already non-stock, the stock revert target this
  tool relies on is wrong. 'status', 'preflight', 'snapshot-stock' and every mclk/persist
  command that touches the memory clock check for this and refuse - see 'status' for the
  three-way source tag (stock / userspace / driver-baked).

WHY THE TIMINGS MATTER: ns = cycles x 1000 / MHz

  Every timing is a fixed CYCLE COUNT. Raise the clock and each one shrinks in
  NANOSECONDS at once, because the cycle got shorter. The DRAM only cares about the
  real ns. Stability = every timing at or above its cell's true minimum (tau_min).
  Stock counts sit near the JEDEC ns at 1728; these stacks BEAT JEDEC, so tau_min is
  EMPIRICAL, not the datasheet. The whole method is one line:
      to hold clock f, set  count = ceil(tau_min x f / 1000)
  Loosen the count as you raise the clock and you hold the same real ns.

THE LEVERS, BY ROLE   (all live via 'fbpa_regs', all cycle counts; CONFIG0-4 decoded
                       and cross-validated 1:1 against nouveau's timing_10_* names)

  ROW / COMMAND - the access sequence. These bind FIRST past the bare ceiling.
    RC RAS RP RD_RCD WR_RCD RFC FAW RRD
    Too tight = HARD HANG (controller wedges, reboot). Lever: loosen x(f/f_stock).
  DATA EYE - the high-clock wall.
    CL (CAS latency = when read data is sampled), WL. Off-centre = SILENT CORRUPTION.
    tCL cannot be raised without re-issuing the DRAM MR2 Read-Latency code (the read
    pointer desyncs) - the deep, risky lever, and the only thing that could move 78.
    On THIS card the eye was NOT the binder (PHY read-strobe swept 8..15 all clean).
  BURST FLOOR - do not touch.
    CCDS / CCDL = the back-to-back burst cadence = the bandwidth floor. Leave stock.
  BUS TURNAROUND - the bus changing direction.
    W2R_BUS / R2W_BUS. Loosen 8 -> 12 for margin at high clock. Cheap, no hang risk.
  WRITE / DATA-PATH
    WR (write recovery), CDLR (fine data-path margin, loosen 9 -> 13 at 77).
  REFRESH - the retention <-> power <-> bandwidth TRIANGLE. The knob most people miss.
    The refresh interval (CONFIG4). It is a linear clock count, so the real interval
    is clock-relative: ns = field x ~1024 x 1000 / MHz. Stock 6 ~= 3.9us at 1728.
      SMALLER = more frequent = better retention, MORE power, LESS bandwidth
      LARGER  = less frequent = worse retention, LESS power, MORE bandwidth
    Measured on this card: at NDIV 76 / 64C the gate held to REFRESH=384 (~49x looser
    than JEDEC) and only wedged at 768 - retention margin at operating temp is huge.
    Looser refresh cut idle power 41 -> 35 W (-15%) and load power ~79 -> 68 W (-14%)
    with latency flat-to-better and bandwidth flat. The SAME field, pulled the other
    way, is the hot-stability lever: at a marginal hot clock, tighter refresh trades
    bandwidth for retention.

HOW THEY INTERACT: THE CONSTRAINT STACK   (which layer binds first, as NDIV rises)

  1. Bare ceiling NDIV 76. Stock counts still clear tau_min. Rock-solid 12/12 hot,
     zero tuning. THIS IS THE SHIP POINT.
  2. NDIV 77 HANG. A row/command timing crosses its floor. Lever: loosen the command
     set. 77 now runs.
  3. NDIV 77 HOT CORRUPTION. This is RETENTION - hot cells leak faster than a stock
     refresh cycles them. Tighter refresh fixes it (proven 8/8) but costs more
     bandwidth than the clock gained (triad drops below stock), so robust-77 is a NET
     LOSS. 76 is the honest ceiling; 78 is a hard cliff (eye-limited - see MR2 above).

THE POWER / EFFICIENCY VIEW

  Read/watt is BEST at stock and falls as the clock rises (power climbs faster than
  read; read plateaus ~1830 GB/s from NDIV 73 up while triad keeps scaling). So you
  do not make a high clock efficient by clocking - you cut the OVERHEAD power. Looser
  refresh does exactly that, where you have retention margin. But refresh margin is
  TEMPERATURE-dependent (JEDEC halves the interval above 85C), and this was validated
  only to ~70C, so the refresh power-lever ships OPT-IN and MODERATE (a target
  interval a few x JEDEC), gated by a pattern test on the user's own card, and you
  keep stock refresh for hot or unknown-thermal deployments. Loosening refresh also
  slightly shrinks row-disturb margin - minor on a single-tenant compute card.

THE METHOD   (how to work the HBM)

  1. Dump the full map ('timings dump'); compute each field's ns at the target clock.
  2. The tightest-ns fields NOT already at a hard floor (CCD) are the binders.
  3. Loosen row/command to kill the hang; bus turnaround for the next margin.
  4. Gate HOT - retention AND the eye are temperature-dependent, a cold gate lies.
     Use the PATTERN sweep (write / hold / read-back), never a compute benchmark:
     a bit-flip in memory the kernel never reads passes a compute check and still
     corrupts. 12+ sweeps, bare where you can (the DDLL eye recal is non-deterministic).
  5. tau_min per field = the failing edge, in cycles x 1000/f. Then
     count = ceil(tau_min x f / 1000) predicts the count at any clock.

WHAT IS MAPPED BUT NOT YET NAMED

  CONFIG5-9 (the 0x009A02A4-02F8 window) are dumped and visible but their field
  packing is not confirmed - no public NVIDIA bit-field map exists for GA100 FBPA,
  and the block is shared across GDDR/HBM generations so magnitudes can be vestigial.
  Best current guesses (HYPOTHESES, not facts): a tZQCS-like field (GDDR heritage,
  maybe inert on HBM), a power-down/tCKE-like field, a self-refresh/ASR register.
  Naming them means empirical poking, which wedged the card once for little payoff -
  deferred. The MR2 eye-retrain is the one deep lever worth a future, careful pass.

MEASURED ON THIS CARD   (GA100, 8 FBPA / 4096-bit, driver 610.43.03 patched)

  stock  NDIV 64 (1728): read 1666  triad 1611  lat 366 ns  idle 41 W
  ROBUST NDIV 76 (2052): read 1829  triad 1875  lat 347 ns   (+10% / +16% / -5%)
                         gated 12/12 hot, BARE - no recal, no daemon, no rebuild.
  NDIV 77: retention-limited hot; net loss. NDIV 78: hard cliff. Ship 76.
EOF
}

cmd_status() {
    is_170hx || say "${c_warn}warning: GPU 0 device id $(devid) is not a 170HX${c_off}"
    if wedged; then
        say "${c_bad}GPU IS WEDGED - run: 170tune recover${c_off}"
    elif ctx_dead; then
        say "${c_bad}GPU ANSWERS BUT TAKES NO CUDA CONTEXT - it is unusable. Run: 170tune recover${c_off}"
        say "${c_bad}  (clocks and NVML look healthy in this state - they are not evidence)${c_off}"
    fi
    printf 'serial      : %s\n' "$(serial)"
    # mclk_source distinguishes stock / a live userspace NDIV / a driver baked non-stock at module
    # load - see the mclk misclassification guard in the HBM levers section below.
    printf 'memory clock: %s MHz  [%s]\n' "$(mclk)" "$(mclk_source)"
    printf 'offset      : %s MHz\n' "$(cur_offset)"
    nvidia-smi --query-gpu=clocks.max.sm,clocks.sm,clocks.mem,power.limit,power.draw,temperature.gpu,temperature.memory,memory.total \
        --format=csv 2>/dev/null | sed 's/^/            /'
    if [ -f "$STATE/armed.json" ]; then
        say "${c_warn}armed marker present (a run is in flight or did not check in):${c_off}"
        sed 's/^/            /' "$STATE/armed.json"
    fi
    [ -f "$STATE/last_crash.json" ] && { say "${c_bad}last crash record:${c_off}"; sed 's/^/            /' "$STATE/last_crash.json"; }
    local s; s=$(serial)
    [ -f "$STATE/results/$s/oc.json" ] && { say "qualified record:"; sed 's/^/            /' "$STATE/results/$s/oc.json"; }
    if [ -n "$s" ] && [ -d "$STATE/quarantine/$s" ] && [ -n "$(ls -A "$STATE/quarantine/$s" 2>/dev/null)" ]; then
        say "${c_warn}quarantined on this card (persist refuses these):${c_off}"
        ls -1 "$STATE/quarantine/$s" | sed 's/^/            /'
    fi
    return 0
}

# try: one measured point. Returns 0 clean, 1 fault, 2 hang.
cmd_try() {
    local off=${1:?offset} clk=${2:?ceiling} secs=${3:-10}
    is_170hx || die "refusing: GPU 0 is not a 170HX (device id $(devid))"
    wedged && die "GPU is wedged - run 'recover' first"
    local x0; x0=$(xids)
    arm "$off" "$clk"
    apply_point "$off" "$clk" || { disarm; die "could not apply offset=$off ceiling=$clk"; }
    local out rc
    out=$(timeout "$MEASURE_TIMEOUT" "$OCEFF" "$secs" 2>&1); rc=$?
    local x1; x1=$(xids)
    disarm
    if [ $rc -eq 124 ]; then
        say "${c_bad}HANG at offset=+$off ceiling=$clk - the measurement never returned${c_off}"
        say "  recover with: 170tune recover   (this class usually needs a reboot)"
        return 2
    fi
    if [ $rc -ne 0 ] || [ "$x1" -gt "$x0" ]; then
        say "${c_bad}FAULT at offset=+$off ceiling=$clk${c_off}  $(echo "$out" | tail -1)"
        return 1
    fi
    printf '%s\n' "$out" | sed 's/^offset=/  offset=/'
    say "${c_warn}  UNVERIFIED: this only means the run completed. Silent corruption looks exactly"
    say "  like this. Prove it with: 170tune gate $off $clk 4${c_off}"
    return 0
}

# gate: the only thing that can call an SM point safe.
cmd_gate() {
    local workload="" pos=()
    while [ $# -gt 0 ]; do
        case "$1" in --workload) workload=${2:?--workload needs a command}; shift 2 ;; *) pos+=("$1"); shift ;; esac
    done
    set -- ${pos[@]+"${pos[@]}"}
    local off=${1:?offset} clk=${2:?ceiling} n=${3:-4}
    is_170hx || die "refusing: GPU 0 is not a 170HX"
    [ -x "$BENCH" ] || die "integrity gate not found at $BENCH - run '170tune install' to build 170hx-sweep, or set BENCH=/path to your own"
    apply_point "$off" "$clk" || die "could not apply offset=$off ceiling=$clk"
    say "gating offset=+$off ceiling=$clk: $n pattern sweeps + ${GATE_COMPUTE}s compute check, each soaked to ${GATE_TEMP}C HBM"
    local fails=0 i res errs tmax=0 t
    for i in $(seq 1 "$n"); do
        arm "$off" "$clk"
        # SOAK FIRST. This matters: the same point passed 4/4 sweeps cold (37-43C) and returned
        # mem_errors=4 once the card had been driven to 51C core / 59C HBM. Hot silicon needs more
        # voltage, so an undervolt that is stable cold corrupts hot. A gate that runs cold lies.
        t=$(soak_to_temp)
        [ "${t:-0}" -gt "$tmax" ] 2>/dev/null && tmax=$t
        res=$(timeout "$SWEEP_TIMEOUT" "$BENCH" --no-unlock 2>&1 | grep -oE "mem_errors=[0-9]+ +compute_ok=[0-9]+" | head -1)
        disarm
        errs=$(printf '%s' "$res" | grep -oE "mem_errors=[0-9]+" | cut -d= -f2)
        if [ -z "$res" ]; then
            say "  sweep $i: ${c_bad}did not complete${c_off}"; fails=$((fails+1)); continue
        fi
        if [ "${errs:-1}" -ne 0 ]; then
            say "  sweep $i: ${c_bad}$res  <- CORRUPTION${c_off}  (HBM ${t}C / core $(core_temp)C)"; fails=$((fails+1))
        else
            say "  sweep $i: ${c_ok}$res${c_off}  (HBM ${t}C / core $(core_temp)C)"
        fi
    done
    # The pattern sweep proves memory. It says nothing about the SM pipeline, where an undervolt
    # can produce wrong arithmetic with memory perfectly clean. Check that separately, while hot.
    if [ -x "$COMPUTE" ] && [ "$GATE_COMPUTE" -gt 0 ]; then
        soak_to_temp >/dev/null
        arm "$off" "$clk"
        local cout crc
        cout=$(timeout $((GATE_COMPUTE + 120)) "$COMPUTE" "$GATE_COMPUTE" 2>&1); crc=$?
        disarm
        if [ $crc -eq 0 ]; then
            say "  compute: ${c_ok}$(printf '%s' "$cout" | tail -2 | head -1)${c_off}"
        else
            say "  compute: ${c_bad}$(printf '%s' "$cout" | tail -2 | tr '\n' ' ')${c_off}"
            fails=$((fails+1))
        fi
    else
        say "  ${c_warn}compute check skipped (compute_check not found) - memory-only gate${c_off}"
    fi
    # The gate above proves memory and one dense GEMM mix. An application is a WIDER mix, and the
    # difference is not academic: balanced/perf/max passed this gate on the reference card and then
    # killed an inference server within seconds. --workload runs your real thing as the last rung.
    if [ -n "$workload" ] && [ "$fails" -eq 0 ]; then
        say "  workload: $workload"
        soak_to_temp >/dev/null
        arm "$off" "$clk"
        local wout wrc
        wout=$(timeout "$WORKLOAD_TIMEOUT" bash -c "$workload" 2>&1); wrc=$?
        disarm
        if [ $wrc -eq 0 ]; then
            say "  workload: ${c_ok}survived${c_off}  $(printf '%s' "$wout" | tail -1)"
        else
            say "  workload: ${c_bad}FAILED (exit $wrc)${c_off}  $(printf '%s' "$wout" | tail -2 | tr '\n' ' ')"
            say "  ${c_warn}this is the case the sweeps cannot see. Quarantine it:${c_off}"
            say "    170tune quarantine $off $clk --reason \"killed: $workload\""
            fails=$((fails+1))
        fi
    fi
    if [ "$fails" -eq 0 ]; then
        say "${c_ok}GATED: offset=+$off ceiling=$clk passed $n/$n sweeps + compute (peak HBM ${tmax}C)${c_off}"
        [ "${tmax:-0}" -lt "$GATE_TEMP" ] 2>/dev/null && say "${c_warn}  CAUTION: HBM never reached ${GATE_TEMP}C (peaked ${tmax}C). Optimistic - raise GATE_SOAK_MAX.${c_off}"
        [ -n "$workload" ] || say "${c_warn}  NOTE: sweeps + GEMM only. A point can pass this and still fault under a real workload"
        [ -n "$workload" ] || say "  (measured: 3 profiles gated clean here and killed an inference server). Re-run with"
        [ -n "$workload" ] || say "  --workload '<your command>' to prove it against the thing you actually run.${c_off}"
        # A rung that is not the production engine is the same mistake one level up: it proves a
        # load nobody will run, and a fault peculiar to that engine rejects a point that serves fine.
        [ -n "$workload" ] && say "${c_warn}  the workload was: $workload - this receipt is only worth something if that is${c_off}"
        [ -n "$workload" ] && say "${c_warn}  the engine that will actually serve.${c_off}"
        write_receipt "$off" "$clk" "$n" "$tmax" "$workload"
        [ "$n" -ge 4 ] || say "${c_warn}  note: $n sweeps is a probe, not a gate. 'persist save' wants 4 - see 'explain'.${c_off}"
        return 0
    fi
    # Count CHECKS, not sweeps: the compute check and the workload are in this tally too, and
    # reporting a failed workload as "n/n sweeps failed" would name the wrong culprit.
    say "${c_bad}REJECTED: $fails check(s) failed out of $n sweep(s) plus compute$([ -n "$workload" ] && printf ' and workload'). Do not ship this point.${c_off}"
    return 1
}

# ladder: raise the offset at one ceiling until it breaks, gating as it goes.
cmd_ladder() {
    local clk=${1:?ceiling} start=${2:-200} step=${3:-50} maxoff=${4:-450}
    local off=$start last_good=""
    say "ladder at ceiling $clk, offsets $start..$maxoff step $step (gate = 2 sweeps per rung)"
    while [ "$off" -le "$maxoff" ]; do
        cmd_try "$off" "$clk" 10; local rc=$?
        if [ $rc -ne 0 ]; then
            say "  stopped: +$off did not survive the measurement"
            break
        fi
        if cmd_gate "$off" "$clk" 2 >/dev/null 2>&1; then
            say "  ${c_ok}+$off gated clean${c_off}"; last_good=$off
        else
            say "  ${c_bad}+$off completed but FAILED the integrity gate - this is the cliff${c_off}"
            break
        fi
        off=$((off + step))
    done
    if [ -n "$last_good" ]; then
        say "${c_ok}highest gated offset at ceiling $clk: +$last_good${c_off}"
        say "ship one step BELOW the cliff, not at it - see 'explain'"
    else
        say "${c_bad}nothing gated clean at ceiling $clk${c_off}"
    fi
    printf '%s' "$last_good"
}

cmd_qualify() {
    local clk=${1:-1350}
    local s; s=$(serial); [ -n "$s" ] || die "no serial - is a card installed?"
    mkdir -p "$STATE/results/$s"
    say "${c_hi}qualifying card $s at ceiling $clk${c_off}"
    say "-- baseline (stock)"
    "$NVML" 0 0 >/dev/null 2>&1; nvidia-smi -rgc >/dev/null 2>&1; nvidia-smi -pl 250 >/dev/null 2>&1
    local base; base=$(timeout "$MEASURE_TIMEOUT" "$OCEFF" 10 2>&1 | tail -1); say "   $base"
    say "-- offset ladder"
    local best; best=$(cmd_ladder "$clk" 200 50 450 | tail -1)
    local ship=""
    if [ -n "$best" ]; then
        ship=$((best - 50))
        say "-- confirming the ship point (+$ship, one step below the highest gated) with 4 sweeps"
        cmd_gate "$ship" "$clk" 4 || { say "${c_bad}ship point failed - dropping another step${c_off}"; ship=$((ship-50)); cmd_gate "$ship" "$clk" 4 || ship=""; }
    fi
    local final; final=$(timeout "$MEASURE_TIMEOUT" "$OCEFF" 10 2>&1 | tail -1)
    cat > "$STATE/results/$s/oc.json" <<EOF
{
  "serial": "$s",
  "qualified": "$(date -Is)",
  "ceiling": $clk,
  "highest_gated_offset": ${best:-null},
  "recommended_offset": ${ship:-null},
  "baseline": "$(printf '%s' "$base" | tr -d '"')",
  "at_recommended": "$(printf '%s' "$final" | tr -d '"')",
  "gate": "full-VRAM pattern sweep, 4x at the recommended point"
}
EOF
    say "${c_ok}recorded: $STATE/results/$s/oc.json${c_off}"
    if [ -n "$ship" ]; then
        say "nothing was made persistent. To adopt this card's own point:"
        say "    170tune apply custom $ship $clk                  (now, this boot only)"
        say "    170tune persist save --offset $ship --clk $clk    (record it)"
        say "    170tune persist enable                            (and at every boot)"
    else
        say "nothing was made persistent, and nothing gated clean - there is no point to adopt."
    fi
}

# selftest - a PASS from this harness only means something if the harness can still detect a
# failure. This checks the DETECTOR PLUMBING deterministically (fault path, corruption parser,
# temperature soak), because the physical positive control is not reproducible on demand: the
# +325/1400 corruption events are real but intermittent, and the same point has since passed
# repeated gates at 60 C HBM. Use --physical to additionally run that point and report what
# happens, but a clean result there is NOT evidence the harness is broken.
cmd_selftest() {
    local physical=0
    [ "${1:-}" = "--physical" ] && { physical=1; shift; }
    local rc=0

    say "${c_hi}== 1. corruption parser: a sweep reporting errors must be rejected${c_off}"
    local probe; probe=$(mktemp)
    cat > "$probe" <<'FAKE'
#!/usr/bin/env bash
echo "    swept 64110 MiB  mem_errors=7  compute_ok=1  bw(h2d)=1.71  hbm_triad=1600.00 GB/s"
FAKE
    chmod +x "$probe"
    if BENCH="$probe" GATE_COMPUTE=0 GATE_SOAK_MAX=0 cmd_gate "${GOOD_OFF:-300}" "${GOOD_CLK:-1350}" 1 >/dev/null 2>&1; then
        say "${c_bad}  FAIL: a sweep reporting mem_errors=7 was accepted. The parser is broken.${c_off}"; rc=1
    else
        say "${c_ok}  ok - mem_errors=7 was caught and rejected${c_off}"
    fi

    say "${c_hi}== 2. incomplete sweep must be treated as a failure, not a pass${c_off}"
    cat > "$probe" <<'FAKE'
#!/usr/bin/env bash
echo "some unrelated output with no result line"
FAKE
    chmod +x "$probe"
    if BENCH="$probe" GATE_COMPUTE=0 GATE_SOAK_MAX=0 cmd_gate "${GOOD_OFF:-300}" "${GOOD_CLK:-1350}" 1 >/dev/null 2>&1; then
        say "${c_bad}  FAIL: a sweep that produced no result line was accepted.${c_off}"; rc=1
    else
        say "${c_ok}  ok - a sweep with no result line counts as a failure${c_off}"
    fi

    say "${c_hi}== 3. compute checker is present and returns clean on a known-good point${c_off}"
    if [ ! -x "$COMPUTE" ]; then
        say "${c_bad}  FAIL: compute_check not found at $COMPUTE - the gate would be memory-only${c_off}"; rc=1
    else
        apply_point "${GOOD_OFF:-300}" "${GOOD_CLK:-1350}" || true
        if timeout 200 "$COMPUTE" 15 >/dev/null 2>&1; then say "${c_ok}  ok - compute checker runs clean${c_off}"
        else say "${c_bad}  FAIL: compute checker reported corruption at a known-good point${c_off}"; rc=1; fi
    fi

    say "${c_hi}== 4. thermal soak actually heats the card${c_off}"
    local t0 t1
    t0=$(gpu_temp); t1=$(GATE_TEMP=${GATE_TEMP} soak_to_temp)
    if [ "${t1:-0}" -ge "$GATE_TEMP" ] 2>/dev/null; then
        say "${c_ok}  ok - HBM reached ${t1}C (target ${GATE_TEMP}C, started ${t0}C)${c_off}"
    else
        say "${c_warn}  WARN: HBM only reached ${t1}C in ${GATE_SOAK_MAX}s (target ${GATE_TEMP}C). Gates will be"
        say "  optimistic on this box - raise GATE_SOAK_MAX or check cooling.${c_off}"
    fi

    if [ "$physical" = "1" ]; then
        say "${c_hi}== 5. physical control: +325/1400 has produced silent corruption before${c_off}"
        say "  NOTE: intermittent. A clean result here does not clear the point and does not"
        say "  indict the harness. It is reported, not asserted."
        cmd_gate 325 1400 2 && say "${c_warn}  the known-bad point came back clean this run${c_off}" \
                            || say "${c_ok}  the known-bad point was caught this run${c_off}"
    fi

    rm -f "$probe"
    if [ $rc -eq 0 ]; then say "${c_ok}SELFTEST PASSED - the detectors work${c_off}"; else say "${c_bad}SELFTEST FAILED - do not trust a PASS from this harness${c_off}"; fi
    return $rc
}

cmd_recover() {
    need_root "$@"
    say "-- clearing offsets and clock locks"
    "$NVML" 0 0 >/dev/null 2>&1 && say "   offset reset to 0" || say "   ${c_warn}offset reset REFUSED (card may be wedged)${c_off}"
    nvidia-smi -rgc >/dev/null 2>&1 && say "   clock lock cleared"
    nvidia-smi -pl 250 >/dev/null 2>&1 && say "   power limit back to 250 W"
    disarm
    # "Responds" is not "recovered". Prove a CUDA context can still be created before claiming it:
    # the card can pass every query-based check and refuse every context. See ctx_dead().
    if ! wedged && ! ctx_dead; then
        say "${c_ok}card responds and takes a CUDA context - recovered${c_off}"
        nvidia-smi --query-gpu=clocks.sm,memory.total --format=csv,noheader
        return 0
    fi
    if wedged; then
        say "${c_warn}card still wedged - trying a driver reload${c_off}"
    else
        say "${c_warn}nvidia-smi answers but no process can create a CUDA context${c_off}"
        say "  (the state where torch reports device_count()=1 with is_available()=False)"
        say "${c_warn}  going straight to a driver reload - clearing offsets cannot fix this${c_off}"
    fi
    systemctl stop nvidia-persistenced 2>/dev/null
    fuser -k /dev/nvidia* 2>/dev/null
    modprobe -r nvidia_uvm nvidia_drm nvidia_modeset nvidia 2>&1 | head -2
    modprobe nvidia 2>&1 | head -2
    systemctl start nvidia-persistenced 2>/dev/null
    sleep 3
    if ! wedged && ! ctx_dead; then say "${c_ok}driver reload recovered it${c_off}"; return 0; fi
    if ! wedged; then
        say "${c_bad}the driver reloaded and nvidia-smi answers, but a CUDA context still cannot be created."
        say "  Check that nothing is holding /dev/nvidia* (fuser -v /dev/nvidia*) and reload again."
        say "  If it persists, this is the reboot case - do not trust the healthy-looking nvidia-smi.${c_off}"
        return 1
    fi
    say "${c_bad}still wedged after a driver reload."
    say "  next step: reboot. If it is still wedged after a reboot, it needs a real power cycle"
    say "  (a warm reboot leaves the card powered). That is hands-on-the-box work.${c_off}"
    return 1
}

# boot-check: run once at boot. If a marker survived, the last thing we tried killed the box.
cmd_boot_check() {
    need_root "$@"
    [ -f "$STATE/armed.json" ] || exit 0
    local this_boot; this_boot=$(cat /proc/sys/kernel/random/boot_id)
    local armed_boot; armed_boot=$(grep -oE '"boot_id": "[^"]+"' "$STATE/armed.json" | cut -d'"' -f4)
    if [ "$this_boot" = "$armed_boot" ]; then exit 0; fi     # same boot, still in flight
    mkdir -p "$STATE"
    { echo "{\"detected\": \"$(date -Is)\", \"note\": \"this setting was in flight when the machine went down\", \"armed\":"; cat "$STATE/armed.json"; echo "}"; } > "$STATE/last_crash.json"
    disarm
    # boot-check runs Before= boot-apply and just cleared the armed marker, so boot-apply's OWN
    # self-disarm can no longer see the stale marker. Signal it to STAY STOCK this boot, so a
    # profile that was in flight during a crash is NOT re-applied (that is the wedge-on-every-boot
    # failure this whole mechanism exists to prevent). The flag is keyed to this boot_id.
    printf '%s\n' "$this_boot" > "$STATE/persist-skip-boot"; sync
    "$NVML" 0 0 >/dev/null 2>&1; nvidia-smi -rgc >/dev/null 2>&1; nvidia-smi -pl 250 >/dev/null 2>&1
    logger -t 170tune "reverted to stock: a tuning run did not check in before the machine went down (see $STATE/last_crash.json)"
    say "reverted to stock. The run that did not check in is recorded in $STATE/last_crash.json"
}

# ================================================================ HBM levers
# The HBM clock (NDIV) and DRAM timings are LIVE userspace BAR0 writes - no
# driver rebuild. hbm_mclk sets the FBPA PLL NDIV; fbpa_regs sets the CONFIG
# timings. The unlock opens the PLMs; 170tune owns the tuning end to end and
# persists the qualified result with a systemd service, not a driver bake.

hbm_guards_ok() {
    local gen mem
    gen=$(nvidia-smi --query-gpu=pcie.link.gen.gpucurrent --format=csv,noheader 2>/dev/null | tr -d ' ')
    mem=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null | grep -oE '[0-9]+' | head -1)
    [ "${gen:-0}" -ge 2 ] 2>/dev/null && [ "${mem:-0}" -ge 40000 ] 2>/dev/null
}
hbm_triad_measure() { [ -x "$TRIAD" ] || return 0; timeout "$MEASURE_TIMEOUT" "$TRIAD" 2>/dev/null | grep -oiE 'triad[^0-9]*[0-9.]+' | grep -oE '[0-9.]+' | tail -1; }
mclk_revert() { [ -x "$HBM_MCLK" ] && "$HBM_MCLK" set "$STOCK_NDIV" >/dev/null 2>&1; }
cur_ndiv() { local n; n=$("$HBM_MCLK" get 2>/dev/null | grep -oE 'NDIV [0-9]+' | grep -oE '[0-9]+' | head -1); echo "${n:-$STOCK_NDIV}"; }

# ---- mclk misclassification guard (HARDWARE-TEST-GATED SECTION) -------------
# A driver built with cmpunlocker's --mclk-ndiv flag bakes a NON-STOCK memory clock into the
# driver's own devinit sequence, so nvidia-smi reports that non-stock value as the card's true
# "current" state - there is no way to tell it apart from a legitimately-stock card by asking
# the driver alone. If snapshot-stock recorded a baked non-stock mclk as "stock", or a live
# mclk-set layered a userspace NDIV write on TOP of a baked one, the revert target itself would
# be corrupted and every safety check downstream of it (gate receipts, persist, boot-apply)
# would silently be comparing against the wrong number.
#
# The discriminator: hbm_mclk reads the FBPA PLL register directly off BAR0 - the true live
# clock, whoever set it. nvidia-smi's clocks.current.memory (mclk() above) reflects the DRIVER's
# own belief instead, which is measured (see mclk_verify below) to be BLIND to a live userspace
# BAR0 write, but NOT blind to a value the driver itself was compiled with, since that is what
# the driver initializes to. So:
#   nvidia-smi mclk == stock AND live NDIV == STOCK_NDIV   -> stock
#   nvidia-smi mclk == stock AND live NDIV != STOCK_NDIV   -> userspace (this tool set it live)
#   nvidia-smi mclk != stock                                -> driver-baked: the driver's own
#                                                                idea of "current" is already
#                                                                non-stock - unsupported
# Prints one of: stock | userspace (NDIV N) | driver-baked (unsupported for tuning) | unknown
mclk_source() {
    local smi_mclk stock_mhz live_ndiv
    smi_mclk=$(mclk)
    stock_mhz=$((STOCK_NDIV * 27))
    [ -n "${smi_mclk:-}" ] || { printf 'unknown'; return 1; }
    if [ "$smi_mclk" != "$stock_mhz" ] 2>/dev/null; then
        printf 'driver-baked (unsupported for tuning)'; return 0
    fi
    # Read the live NDIV DIRECTLY (not via cur_ndiv, which defaults to STOCK_NDIV on failure): a
    # register we could not read is NOT a stock register. hbm_mclk needs root to mmap BAR0, so a
    # non-root `status` lands here - say so instead of falsely reporting 'stock' on an OC'd card.
    live_ndiv=""
    [ -x "$HBM_MCLK" ] && live_ndiv=$("$HBM_MCLK" get 2>/dev/null | grep -oE 'NDIV [0-9]+' | grep -oE '[0-9]+' | head -1)
    if [ -z "$live_ndiv" ]; then
        printf 'unknown - run as root to read the PLL'; return 1
    fi
    if [ "$live_ndiv" != "$STOCK_NDIV" ]; then
        printf 'userspace (NDIV %s)' "$live_ndiv"; return 0
    fi
    printf 'stock'; return 0
}
# Convenience: die with the standard remediation message if this driver is baked non-stock.
# Called by snapshot-stock, mclk-try/mclk-gate, and persist save.
refuse_if_mclk_baked() {
    case "$(mclk_source)" in
        driver-baked*) die "refusing $1: mclk is $(mclk_source) - rebuild a stock driver; use userspace mclk control" ;;
    esac
}

# Apply the custom-timing profile for NDIV $1: command/row timings scaled from stock to hold stock ns
# (C_new = round(C_stock * ndiv / STOCK_NDIV)), plus bus turnaround 8->12 and CDLR 9->13 - the margin
# that closes the top of the range. Deterministic; no DDLL recal. Extends the robust ceiling (76->77).
hbm_timing_tune() {
    local ndiv=$1 kv f s
    [ -x "$FBPA_REGS" ] || { say "${c_warn}fbpa_regs not found - cannot apply timing tune${c_off}"; return 1; }
    for kv in $STOCK_TIMINGS; do
        f=${kv%:*}; s=${kv#*:}
        case "$f" in
            W2R_BUS|R2W_BUS) "$FBPA_REGS" set "$f" 12 >/dev/null 2>&1 ;;
            CDLR)            "$FBPA_REGS" set "$f" 13 >/dev/null 2>&1 ;;
            *)               "$FBPA_REGS" set "$f" "$(( (s * ndiv + STOCK_NDIV/2) / STOCK_NDIV ))" >/dev/null 2>&1 ;;
        esac
    done
}
# Restore every tuned field to its stock cycle count.
hbm_timing_stock() {
    [ -x "$FBPA_REGS" ] || return 1
    local kv; for kv in $STOCK_TIMINGS; do "$FBPA_REGS" set "${kv%:*}" "${kv#*:}" >/dev/null 2>&1; done
}
# Print the tune profile for NDIV $1 as a "FIELD val ..." string (for persist save --timings).
hbm_timing_profile() {
    local ndiv=$1 kv f s out=""
    for kv in $STOCK_TIMINGS; do
        f=${kv%:*}; s=${kv#*:}
        case "$f" in
            W2R_BUS|R2W_BUS) out="$out $f 12" ;;
            CDLR)            out="$out $f 13" ;;
            *)               out="$out $f $(( (s * ndiv + STOCK_NDIV/2) / STOCK_NDIV ))" ;;
        esac
    done
    printf '%s' "${out# }"
}

# ---- refresh: the retention <-> power <-> bandwidth lever -------------------
# The refresh interval (CONFIG4 REFRESH field) is a linear clock count with a
# ~1024-clock granularity, so the REAL interval is clock-relative:
#   interval_ns = field * 1024 * 1000 / mclk_MHz ;  field = round(us * mclk / 1024)
# Looser (bigger field) = less refresh = less power/heat and slightly better
# latency, at the cost of retention. Retention is TEMPERATURE-dependent and was
# validated only to ~70C on the bench, so this ships OPT-IN + MODERATE + gated by
# a HOT pattern sweep on the user's own card. Persist it by putting "REFRESH <f>"
# in the persist save --timings string (boot-apply reapplies it; no daemon).
refresh_field_for_us() { awk -v us="$1" -v mclk="$2" 'BEGIN{ f=int(us*mclk/1024 + 0.5); if(f<1)f=1; print f }'; }
refresh_us_for_field() { awk -v f="$1" -v mclk="$2" 'BEGIN{ printf "%.1f", f*1024.0/mclk }'; }

cmd_refresh() {
    [ -x "$FBPA_REGS" ] || die "fbpa_regs not found at $FBPA_REGS (set FBPA_REGS=...)"
    local sub=${1:-status}; shift 2>/dev/null || true
    local ndiv mclk_l f us
    ndiv=$(cur_ndiv); mclk_l=$(( ndiv * 27 ))
    case "$sub" in
        status)
            f=$("$FBPA_REGS" get REFRESH 2>/dev/null)
            us=$(refresh_us_for_field "${f:-6}" "$mclk_l")
            printf 'mem clock  : NDIV %s (~%s MHz)\n' "$ndiv" "$mclk_l"
            printf 'REFRESH    : %s  (interval ~%s us; stock field %s ~= %s us; JEDEC target 3.9 us)\n' \
                   "${f:-?}" "$us" "$STOCK_REFRESH" "$(refresh_us_for_field "$STOCK_REFRESH" "$mclk_l")"
            ;;
        set)
            us=${1:?usage: refresh set <interval_us>   (stock ~= 3.9)}
            f=$(refresh_field_for_us "$us" "$mclk_l")
            # moderate-by-default guard: >4x the stock interval is aggressive for an unvalidated-hot card
            if awk -v u="$us" 'BEGIN{exit !(u>16)}'; then
                say "${c_warn}note: ${us}us is >4x stock (~4us). Aggressive - gate it HOT on THIS card and keep stock refresh for >80C or unknown thermals.${c_off}"
            fi
            "$FBPA_REGS" set REFRESH "$f" >/dev/null 2>&1
            local rb; rb=$("$FBPA_REGS" get REFRESH 2>/dev/null)
            [ "$rb" = "$f" ] || die "REFRESH write did not take (wrote $f, reads ${rb:-?})"
            say "REFRESH set to field $f (~$(refresh_us_for_field "$f" "$mclk_l") us at NDIV $ndiv). Live only - persist via 'persist save --timings \"REFRESH $f\"'. Prove it: 170tune refresh gate $us"
            ;;
        gate)
            us=${1:?usage: refresh gate <interval_us> [n]}; local n=${2:-12}
            f=$(refresh_field_for_us "$us" "$mclk_l")
            "$FBPA_REGS" set REFRESH "$f" >/dev/null 2>&1
            say "gating REFRESH field $f (~$(refresh_us_for_field "$f" "$mclk_l") us at NDIV $ndiv): $n HOT pattern sweeps."
            say "  ${c_warn}retention is temperature-dependent - this proves the interval only up to the HBM temp reached below.${c_off}"
            if _hot_gate_sweeps "$n" "refresh$f" "$GATE_SOAK_MAX"; then
                say "${c_ok}GATED: REFRESH field $f held $n/$n hot. Persist with: persist save --timings \"REFRESH $f\"${c_off}"
                return 0
            fi
            say "${c_bad}REJECTED: REFRESH field $f failed hot - too loose for this card/temp. Reverting to stock refresh.${c_off}"
            "$FBPA_REGS" set REFRESH "$STOCK_REFRESH" >/dev/null 2>&1
            return 1
            ;;
        stock)
            "$FBPA_REGS" set REFRESH "$STOCK_REFRESH" >/dev/null 2>&1
            say "REFRESH restored to stock field $STOCK_REFRESH (~$(refresh_us_for_field "$STOCK_REFRESH" "$mclk_l") us)"
            ;;
        *) die "usage: refresh {status | set <us> | gate <us> [n] | stock}" ;;
    esac
}

# Apply NDIV live and prove the clock actually MOVED. hbm_mclk's exit code is the
# lock+readback proof (0 locked at N, 2 PLM closed, 3 no-lock->restored). We add
# the memclk==N*27 and the >stock-wall bandwidth anchor (impossible unless moved).
mclk_verify() {
    local ndiv=${1:?ndiv} rc
    "$HBM_MCLK" set "$ndiv"; rc=$?
    case $rc in
        0) "$HBM_MCLK" ddll >/dev/null 2>&1 ;;  # recal the PHY data eye at the live clock (lifts 70->75)
        2) say "${c_bad}PLM closed - the unlock is not applied; a host NDIV write is dropped${c_off}"; return 1 ;;
        3) say "${c_bad}PLL did not lock at NDIV $ndiv (COEFF restored to stock)${c_off}"; return 1 ;;
        *) say "${c_bad}hbm_mclk failed (rc=$rc)${c_off}"; return 1 ;;
    esac
    hbm_guards_ok || say "${c_warn}guard: pcie<Gen2 or memory<40GB after the NDIV set - unlock/link disturbed${c_off}"
    # nvidia-smi clocks.current.memory is BLIND to this PLL change (always reports the stock 1728);
    # it is informational only. The clock-moved proof is BANDWIDTH: a triad exceeding the stock wall
    # (1769 GB/s @ 1728) is physically impossible unless the clock rose. This also catches the real
    # cliff where the COEFF write locks but the DELIVERED rate clamps (triad stays at/under the wall).
    local mc; mc=$(mclk)
    local tr; tr=$(hbm_triad_measure)
    if [ -z "$tr" ]; then
        say "  NDIV $ndiv: PLL locked; no triad tool (set TRIAD=/path) - clock-moved UNPROVEN, relying on the gate"
        return 0
    fi
    say "  NDIV $ndiv: triad ${tr} GB/s  (smi memclk ${mc} MHz, blind)"
    if awk -v t="$tr" -v w="$STOCK_WALL" 'BEGIN{exit !(t>w)}'; then
        return 0   # triad > stock wall => the clock genuinely moved
    fi
    say "${c_bad}triad ${tr} <= stock wall ${STOCK_WALL} GB/s - the COEFF write locked but the delivered clock did NOT move (clamped). This is the ceiling.${c_off}"
    return 1
}

# The hot correctness core, shared by mclk-gate and timings-gate. The caller has
# already applied the point. Soak to GATE_TEMP FIRST, run n full-VRAM sweeps + a
# bit-exact compute check, all HOT. A gate that never got hot is a FAILURE, not a
# warning - the silent-corruption regime is temperature dependent.
#
# WEDGE DETECTOR: a hung context is a wedge here too, not just on the SM side. A too-aggressive
# NDIV or timing can leave the card answering nvidia-smi while no CUDA context can be created -
# the same class ctx_dead() exists to catch on 'status'/'recover'. Check it explicitly, every
# round: waiting for the user to notice via 'status' after the fact is not a gate.
_hot_gate_sweeps() {
    local n=${1:-4} label=${2:-oc} soakmax=${3:-$GATE_SOAK_MAX} recal=${4:-}
    [ -x "$SELFTEST" ] || die "gpu_selftest not found at $SELFTEST (set SELFTEST=...)"
    local fails=0 i res errs tmax=0 t
    # Soak to operating temp ONCE, then recal the eye ONCE in that state. Do NOT re-soak (oc_eff)
    # between sweeps: a heavy core soak between sweeps swings the core clock and drifts the eye - a
    # GATE ARTIFACT that faults even a rock-solid NDIV. Steady back-to-back memory sweeps hold temp
    # and are production-representative; a single recal holds robustly under them (measured).
    arm "$label" 0
    t=$(GATE_SOAK_MAX=$soakmax soak_to_temp); tmax=${t:-0}
    [ -n "$recal" ] && "$HBM_MCLK" ddll >/dev/null 2>&1
    disarm
    local out cok swept
    for i in $(seq 1 "$n"); do
        arm "$label" 0
        out=$(timeout "$SWEEP_TIMEOUT" "$SELFTEST" "${SWEEP_FRAC:-0.15}" 2>&1)
        disarm
        t=$(gpu_temp); [ "${t:-0}" -gt "$tmax" ] 2>/dev/null && tmax=$t
        # rare: if the card cooled below the gate floor, re-soak AND re-recal (a soak swings the core)
        if [ "${t:-0}" -lt "$GATE_TEMP" ] 2>/dev/null; then
            GATE_SOAK_MAX=$soakmax soak_to_temp >/dev/null; [ -n "$recal" ] && "$HBM_MCLK" ddll >/dev/null 2>&1
        fi
        errs=$(printf '%s' "$out" | grep -oE 'MEM_ERRORS=[0-9]+' | head -1 | cut -d= -f2)
        cok=$(printf '%s' "$out" | grep -oE 'COMPUTE_OK=[0-9]+' | head -1 | cut -d= -f2)
        swept=$(printf '%s' "$out" | grep -oE 'MEM_SWEPT_MIB=[0-9]+' | head -1 | cut -d= -f2)
        # A missing MEM_ERRORS means the sweep did not run (tool path, permissions) - FAIL, never pass.
        if [ -z "$errs" ]; then say "  sweep $i: ${c_bad}did not run (no MEM_ERRORS from $SELFTEST)${c_off}"; fails=$((fails + 1)); continue; fi
        if [ "$errs" -ne 0 ] || [ "${cok:-0}" -ne 1 ]; then
            say "  sweep $i: ${c_bad}mem_errors=$errs compute_ok=${cok:-?}  <- CORRUPTION${c_off}  (${swept:-?}MiB, HBM ${t}C)"; fails=$((fails + 1))
        else
            say "  sweep $i: ${c_ok}mem_errors=0 compute_ok=1${c_off}  (${swept:-?}MiB, HBM ${t}C)"
        fi
    done
    if [ -x "$COMPUTE" ] && [ "$GATE_COMPUTE" -gt 0 ]; then
        GATE_SOAK_MAX=$soakmax soak_to_temp >/dev/null
        arm "$label" 0
        local crc; timeout $((GATE_COMPUTE + 120)) "$COMPUTE" "$GATE_COMPUTE" >/dev/null 2>&1; crc=$?
        disarm
        [ $crc -eq 0 ] && say "  compute: ${c_ok}clean${c_off}" || { say "  compute: ${c_bad}FAILED${c_off}"; fails=$((fails + 1)); }
    else
        say "  ${c_warn}compute check skipped (compute_check not found) - memory-only gate${c_off}"
    fi
    # WEDGE DETECTOR WIN: check ctx_dead unconditionally, even if every sweep above looked clean.
    # A card can pass a memory sweep and still refuse every CUDA context - query-based checks alone
    # would call this a pass.
    if ctx_dead; then
        say "  ${c_bad}context check: FAILED - the card answers nvidia-smi but no CUDA context can be created${c_off}"
        say "  ${c_bad}  this is the wedge query-based checks miss. Do not trust the sweep results above - recover first.${c_off}"
        fails=$((fails + 1))
    fi
    if [ "${tmax:-0}" -lt "$GATE_TEMP" ] 2>/dev/null; then
        say "${c_bad}REJECTED: HBM never reached ${GATE_TEMP}C (peaked ${tmax}C) - a cold gate cannot bless $label${c_off}"
        return 1
    fi
    [ "$fails" -eq 0 ] && { say "${c_ok}GATED: $label passed $n/$n sweeps + compute (peak HBM ${tmax}C)${c_off}"; return 0; }
    say "${c_bad}REJECTED: $fails/$n failed ($label)${c_off}"; return 1
}

cmd_mclk_try() {
    local ndiv=${1:?usage: mclk-try <NDIV>}
    is_170hx || die "refusing: GPU 0 is not a 170HX"; [ -x "$HBM_MCLK" ] || die "hbm_mclk not found at $HBM_MCLK"
    refuse_if_mclk_baked "mclk-try"
    wedged && die "GPU is wedged - run 'recover' first"
    ctx_dead && die "GPU answers but takes no CUDA context - it is unusable. Run: 170tune recover"
    arm "mclk$ndiv" "$((ndiv * 27))"
    mclk_verify "$ndiv" || { disarm; mclk_revert; return 1; }
    disarm
    say "${c_warn}UNVERIFIED: the clock moved and the PLL locked, but silent corruption looks exactly"
    say "like this. Prove it hot with: 170tune mclk-gate $ndiv 4${c_off}"
}

cmd_mclk_gate() {
    local ndiv=${1:?usage: mclk-gate <NDIV> [n]} n=${2:-4}
    is_170hx || die "refusing: GPU 0 is not a 170HX"; [ -x "$HBM_MCLK" ] || die "hbm_mclk not found at $HBM_MCLK"
    refuse_if_mclk_baked "mclk-gate"
    wedged && die "GPU is wedged - run 'recover' first"
    ctx_dead && die "GPU answers but takes no CUDA context - it is unusable. Run: 170tune recover"
    # Core at NATURAL clock (stock offset, free) - production-representative. Do NOT pin it, and do
    # NOT route through mclk_verify here: its early recal + full nvidia_bench between two recals
    # disturbs the eye. The gate is the proven-clean recipe: set NDIV, soak once, recal the eye
    # ONCE in the hot operating state, then steady back-to-back sweeps (_hot_gate_sweeps).
    "$NVML" 0 0 >/dev/null 2>&1; nvidia-smi -rgc >/dev/null 2>&1; nvidia-smi -pl 250 >/dev/null 2>&1
    # Loosen the timings BEFORE the NDIV bump. Timings are clock-independent cycle counts and looser is
    # always safe at the lower clock, so the jump to the target NDIV never passes through the bare-hang
    # window (stock timings at a too-high clock hard-hang). Applying the tune AFTER the bump risks that.
    if [ -n "$MCLK_TUNE" ]; then hbm_timing_tune "$ndiv"; fi
    local rc; "$HBM_MCLK" set "$ndiv" >/dev/null 2>&1; rc=$?
    if [ $rc -eq 2 ]; then say "${c_bad}FBPA_PLL PLM closed - unlock not applied${c_off}"; [ -n "$MCLK_TUNE" ] && hbm_timing_stock; return 1; fi
    if [ $rc -ne 0 ]; then say "${c_bad}NDIV $ndiv did not lock (rc=$rc)${c_off}"; [ -n "$MCLK_TUNE" ] && hbm_timing_stock; mclk_revert; return 1; fi
    say "gating NDIV=$ndiv ($((ndiv * 27)) MHz): $n hot sweeps (core natural)${MCLK_TUNE:+ + timing tune}, cold-gate = FAIL"
    _hot_gate_sweeps "$n" "mclk$ndiv" "$MCLK_GATE_SOAK_MAX" "${MCLK_RECAL:+recal}"
    local grc=$?
    [ -n "$MCLK_TUNE" ] && hbm_timing_stock   # restore stock timings after the gate
    return $grc
}

cmd_mclk_ladder() {
    local start=${1:-65} step=${2:-1} max=${3:-80}
    is_170hx || die "refusing: GPU 0 is not a 170HX"; [ -x "$HBM_MCLK" ] || die "hbm_mclk not found at $HBM_MCLK"
    refuse_if_mclk_baked "mclk-ladder"
    say "mclk ladder NDIV $start..$max step $step (live userspace, hot gate each rung, core pinned stock)"
    mclk_revert  # baseline reference at stock
    local ndiv=$start last_good=""
    while [ "$ndiv" -le "$max" ]; do
        say "${c_hi}-- NDIV $ndiv ($((ndiv * 27)) MHz) --${c_off}"
        if cmd_mclk_gate "$ndiv" 4; then
            last_good=$ndiv
        else
            say "  ${c_bad}NDIV $ndiv failed the gate or did not lock - this is the cliff${c_off}"
            break
        fi
        ndiv=$((ndiv + step))
    done
    if [ -n "$last_good" ]; then
        "$HBM_MCLK" set "$last_good" >/dev/null 2>&1; "$HBM_MCLK" ddll >/dev/null 2>&1
        say "${c_ok}highest gated NDIV: $last_good ($((last_good * 27)) MHz). Card left there (VOLATILE).${c_off}"
        say "ship one step below the cliff; persist across reboot with: 170tune persist save --ndiv $last_good && 170tune persist enable"
    else
        mclk_revert
        say "${c_bad}nothing gated clean; card left at stock NDIV $STOCK_NDIV${c_off}"
    fi
    printf '%s' "$last_good"
}

# HBM bandwidth MATRIX: read/copy/triad per NDIV - the companion to mclk-ladder's
# gated qualification, exactly like the GPC bf16-GEMM matrix is the companion to
# its qualification matrix. FAST and UNVERIFIED: a row means the clock delivered
# that bandwidth, NOT that the point is correct. Only mclk-gate / mclk-ladder (hot
# full-VRAM sweep) call an NDIV safe. Rows are appended to a per-serial CSV.
cmd_hbm_matrix() {
    local start=${1:-64} step=${2:-2} max=${3:-78}
    is_170hx || die "refusing: GPU 0 is not a 170HX"
    [ -x "$HBM_MCLK" ] || die "hbm_mclk not found at $HBM_MCLK"
    [ -x "$MEMPROBE" ] || die "mem_probe not found at $MEMPROBE (run '170tune install')"
    [ -x "$NVBENCH" ]  || die "nvidia_bench not found at $NVBENCH (run '170tune install')"
    local s csv hdr; s=$(serial); mkdir -p "$STATE"; csv="$STATE/hbm_matrix_${s}.csv"
    hdr="utc,ndiv,mhz,peak_gbs,read_gbs,pct_peak,triad_gbs,copy_gbs,write_gbs,d2d_gbs,nvbench_read_gbs,lat_ns,power_w,gbs_per_w,mem_c,core_c,delta_stock_pct,moved"
    # A CSV from an older, narrower schema would otherwise get new wide rows appended under a stale
    # header. Rotate it so the file is never mixed-schema; a fresh run then writes the current header.
    [ -f "$csv" ] && [ "$(head -1 "$csv" 2>/dev/null)" != "$hdr" ] && mv "$csv" "${csv}.$(date -u +%Y%m%dT%H%M%SZ).bak" 2>/dev/null
    [ -f "$csv" ] || echo "$hdr" > "$csv"
    say "${c_hi}HBM matrix - card $s (NDIV $start..$max step $step)${c_off}"
    say "${c_warn}UNVERIFIED: a row is delivered bandwidth/latency, not safety - only mclk-gate / mclk-ladder"
    say "qualify an NDIV. READ = mem_probe peak read; TRIAD/COPY/D2D = nvidia_bench; LAT = dependent-load (ns)."
    say "OC rows are measured at REFRESH ${HBM_MATRIX_REFRESH} (the power-optimized ship setting); the stock NDIV"
    say "$STOCK_NDIV row stays fully stock (REFRESH ${STOCK_REFRESH}). PWR is MEAN board draw sampled DURING the read"
    say "load; GB/s/W = read/watt; dSTOCK = read vs stock; MOVED = read past the ${STOCK_WALL} GB/s stock wall (the"
    say "clock-moved proof - nvidia-smi is blind to a userspace NDIV). Raw rows: $csv${c_off}"
    printf '%-4s %-5s %6s %7s %5s %7s %7s %7s %7s %6s %7s %5s %7s %s\n' \
        NDIV MHz PEAK READ %PK TRIAD COPY D2D LAT_ns PWR_W GB/s/W MEMC dSTOCK MOVED
    local ndiv=$start stock_read=""
    while [ "$ndiv" -le "$max" ]; do
        local rrefresh=$HBM_MATRIX_REFRESH
        if [ "$ndiv" = "$STOCK_NDIV" ]; then mclk_revert; rrefresh=$STOCK_REFRESH
        elif ! "$HBM_MCLK" set "$ndiv" >/dev/null 2>&1; then
            printf '%-4s %-5s %6s  %s\n' "$ndiv" "$((ndiv * 27))" "-" "did not lock"
            echo "$(date -u +%Y-%m-%dT%H:%M:%SZ),$ndiv,$((ndiv * 27)),,,,,,,,,,,,,,,nolock" >> "$csv"
            ndiv=$((ndiv + step)); continue
        fi
        # OC rungs run at the ship refresh; the stock NDIV row stays at stock refresh (honest baseline)
        [ -x "$FBPA_REGS" ] && "$FBPA_REGS" set REFRESH "$rrefresh" >/dev/null 2>&1
        sleep 1
        # mem_probe = the peak streaming read + dependent-load latency. Sample board power WHILE it
        # runs (a pure read load); do NOT sample after nvidia_bench, whose trailing compute phase
        # (bf16/int8 tensor, ~200 TFLOPS) would dominate a post-hoc reading and overstate HBM power.
        local mptmp mpread mplat pw memc corec p mppid
        mptmp=$(mktemp 2>/dev/null) || mptmp="$STATE/.mp.$$"
        timeout "$MEASURE_TIMEOUT" "$MEMPROBE" >"$mptmp" 2>/dev/null &
        mppid=$!; local psum=0 pn=0
        while kill -0 "$mppid" 2>/dev/null; do
            p=$(nvidia-smi    --query-gpu=power.draw         --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
            case "$p" in ''|*[!0-9.]*) : ;; *) psum=$(awk -v s="$psum" -v x="$p" 'BEGIN{print s+x}'); pn=$((pn+1)) ;; esac
            memc=$(nvidia-smi --query-gpu=temperature.memory --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
            corec=$(nvidia-smi --query-gpu=temperature.gpu   --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
            sleep 1
        done
        wait "$mppid" 2>/dev/null
        # MEAN board draw across the read load, not peak - a pure read spikes, and the mean is the
        # representative steady figure, comparable to the sustained-load numbers elsewhere in the docs.
        pw=$(awk -v s="$psum" -v n="$pn" 'BEGIN{ if(n>0) printf "%.1f", s/n; else print "" }')
        [ -n "$pw" ] || pw=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
        mpread=$(grep -oE 'read_bw = [0-9.]+' "$mptmp" | grep -oE '[0-9.]+')
        mplat=$(grep -oE 'dram_latency = [0-9.]+' "$mptmp" | grep -oE '[0-9.]+' | head -1)
        rm -f "$mptmp"
        # nvidia_bench --csv: STREAM read/write/copy/triad + cudaMemcpy D2D (fields 14/15/16/17/18);
        # its compute-TFLOPS tail is ignored - we read only the bandwidth columns.
        local line nvread nvwrite cp tr d2d
        line=$(timeout "$MEASURE_TIMEOUT" "$NVBENCH" --csv 2>/dev/null | tail -1)
        nvread=$(printf  '%s' "$line" | awk -F, '{print $14}')
        nvwrite=$(printf '%s' "$line" | awk -F, '{print $15}')
        cp=$(printf      '%s' "$line" | awk -F, '{print $16}')
        tr=$(printf      '%s' "$line" | awk -F, '{print $17}')
        d2d=$(printf     '%s' "$line" | awk -F, '{print $18}')
        [ "$ndiv" = "$STOCK_NDIV" ] && stock_read=${mpread:-}
        # derive theoretical peak, % of peak, read-per-watt, delta vs stock, and the clock-moved flag
        local mhz=$((ndiv * 27)) peak pct gw dpct moved
        read -r peak pct gw dpct moved < <(awk -v r="${mpread:-0}" -v mhz="$mhz" -v pw="${pw:-0}" \
            -v sr="${stock_read:-0}" -v wall="$STOCK_WALL" 'BEGIN{
                peak=mhz*1.024;
                printf "%.0f ", peak;
                printf "%s ",  (peak>0 ? sprintf("%.1f",  100*r/peak)      : "-");
                printf "%s ",  (pw>0   ? sprintf("%.1f",  r/pw)            : "-");
                printf "%s ",  (sr>0   ? sprintf("%+.1f", 100*(r-sr)/sr)   : "-");
                printf "%s",   (r>wall ? "yes" : "-"); }')
        printf '%-4s %-5s %6s %7s %5s %7s %7s %7s %7s %6s %7s %5s %7s %s\n' \
            "$ndiv" "$mhz" "$peak" "${mpread:-?}" "$pct" "${tr:-?}" "${cp:-?}" "${d2d:-?}" "${mplat:-?}" "${pw:-?}" "$gw" "${memc:-?}" "$dpct" "$moved"
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ),$ndiv,$mhz,$peak,${mpread:-},$pct,${tr:-},${cp:-},${nvwrite:-},${d2d:-},${nvread:-},${mplat:-},${pw:-},$gw,${memc:-},${corec:-},$dpct,$moved" >> "$csv"
        ndiv=$((ndiv + step))
    done
    mclk_revert
    [ -x "$FBPA_REGS" ] && "$FBPA_REGS" set REFRESH "$STOCK_REFRESH" >/dev/null 2>&1
    say "${c_ok}matrix done; card reverted to stock (NDIV $STOCK_NDIV, REFRESH $STOCK_REFRESH). Rows appended to $csv${c_off}"
    say "READ (mem_probe peak) is the headline; TRIAD (read+write) is the decode proxy; LAT is dependent-load."
    say "PWR is mean draw sampled during the read load, at REFRESH ${HBM_MATRIX_REFRESH} for the OC rows."
    say "MOVED past the ${STOCK_WALL} GB/s stock wall is the clock-moved proof - a read above it is impossible"
    say "unless the DRAM clock actually rose, which is the one thing nvidia-smi cannot show."
}

cmd_timings() {
    local sub=${1:-dump}; shift 2>/dev/null || true
    [ -x "$FBPA_REGS" ] || die "fbpa_regs not found at $FBPA_REGS (build: 170tune install)"
    case "$sub" in
        dump) "$FBPA_REGS" dump ;;
        get)  "$FBPA_REGS" get "$@" ;;
        set)  arm "timings" 0; "$FBPA_REGS" set "$@"; disarm ;;
        save) "$FBPA_REGS" save "$@" ;;
        load) "$FBPA_REGS" load "$@" ;;
        *)    die "usage: 170tune timings dump | get <FIELD> | set <FIELD> <cyc> | save <file> | load <file>" ;;
    esac
}

cmd_timings_gate() {
    local f=${1:?usage: timings-gate <FIELD> <cyc> [n]} v=${2:?value} n=${3:-4}
    is_170hx || die "refusing: GPU 0 is not a 170HX"; [ -x "$FBPA_REGS" ] || die "fbpa_regs not found at $FBPA_REGS"
    wedged && die "GPU is wedged - run 'recover' first"
    ctx_dead && die "GPU answers but takes no CUDA context - it is unusable. Run: 170tune recover"
    "$FBPA_REGS" set "$f" "$v" || { say "${c_bad}fbpa_regs set $f $v failed${c_off}"; return 1; }
    say "gating timing $f=$v: $n hot sweeps, cold-gate = FAIL"
    _hot_gate_sweeps "$n" "tim-$f$v" "$GATE_SOAK_MAX"
}

# --------------------------------------------------------------- persistence
# A boot service re-applies the QUALIFIED per-card profile in userspace AFTER
# the driver is up. The box always boots on stock, so a bad profile can be
# masked over ssh - it can never block boot the way a baked-in driver NDIV can.
install_persist_unit() {
    cat > "$PERSIST_UNIT" <<UNIT
[Unit]
Description=170tune - re-apply the qualified CMP 170HX overclock profile (userspace, post-driver)
# After the nvidia driver is up and GSP has finished (PLMs open, post-GSP), never
# early boot. A bad profile then cannot block boot; mask it over ssh to recover.
After=nvidia-persistenced.service systemd-user-sessions.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
# Bake the RESOLVED tool paths in. boot-apply runs as root, where find_tool's ~ fallback
# resolves to /root - so without these, a box whose tools are not in /usr/local/bin would
# silently fail to find them and self-disarm to stock. These env vars win over find_tool.
Environment=HBM_MCLK=$HBM_MCLK
Environment=FBPA_REGS=$FBPA_REGS
Environment=NVML=$NVML
ExecStart=$SELF boot-apply
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
UNIT
}

# Read a profile's point out of 170hx-oc rather than keeping a second copy of the table here.
# Also what 'persist save --profile <name>' uses to resolve a named SM profile to a concrete
# offset/ceiling at save time - the boot-apply conf always stores raw numbers, never a name.
profile_point() { "$OCAPPLY" --print "$@" 2>/dev/null; }

# ---- SM receipt + quarantine gate (HARDWARE-TEST-GATED SECTION) -------------
# Only reached when 'persist save' is given an SM point (--offset/--clk, or a --profile that
# resolves to one). The whole reason gate receipts and quarantine exist is that 'gate' proved
# this on THIS card - persisting a point this card never proved, or one this card has since
# quarantined, is exactly the failure this harness is built to prevent. Returns 0 = ok to
# persist, 1 = refused (unless force=1, which downgrades every refusal below to a loud warning
# and proceeds anyway - the same --force contract 'gate'/'quarantine' use elsewhere).
sm_receipt_gate() {
    local off=$1 clk=$2 force=${3:-0}
    local qf; qf=$(quarantine_file "$off" "$clk")
    if [ -f "$qf" ]; then
        say "${c_bad}QUARANTINED on this card: +$off/$clk is recorded as known-bad${c_off}"
        sed 's/^/            /' "$qf"
        say "  a passing gate receipt does not clear this - the gate is what missed it."
        say "  if you believe it is fixed:  170tune unquarantine $off $clk"
        [ "$force" = 1 ] || return 1
        say "${c_warn}  --force: persisting a quarantined point anyway${c_off}"
    fi
    local rf; rf=$(receipt_file "$off" "$clk")
    local sweeps=0 peak=0 rec_mclk live_mclk
    [ -f "$rf" ] && sweeps=$(grep -oE '"sweeps": *[0-9]+' "$rf" | grep -oE '[0-9]+$')
    [ -f "$rf" ] && peak=$(grep -oE '"peak_hbm_c": *[0-9]+' "$rf" | grep -oE '[0-9]+$')
    [ -f "$rf" ] && rec_mclk=$(grep -oE '"mclk_mhz": *[0-9]+' "$rf" | grep -oE '[0-9]+$')
    live_mclk=$(mclk)
    if [ ! -f "$rf" ]; then
        say "${c_bad}NOT GATED on this card (serial $(serial)): no receipt for offset=+$off ceiling=$clk${c_off}"
        say "  the numbers in the profile table are the REFERENCE card's silicon, not yours."
        say "  prove it here first:  170tune gate $off $clk 4"
        [ "$force" = 1 ] || return 1
        say "${c_warn}  --force: persisting an unproven point anyway${c_off}"
    elif [ "${sweeps:-0}" -lt 4 ]; then
        say "${c_warn}thin evidence: the receipt for +$off/$clk is only ${sweeps} sweep(s).${c_off}"
        say "  the corruption at +325/1400 passed 4 cold sweeps and still failed hot - see 'explain'."
        say "  strengthen it:  170tune gate $off $clk 4"
        [ "$force" = 1 ] || return 1
        say "${c_warn}  --force: persisting on ${sweeps} sweep(s) anyway${c_off}"
    elif [ -n "${rec_mclk:-}" ] && [ -n "${live_mclk:-}" ] && [ "$rec_mclk" != "$live_mclk" ]; then
        # The memory clock is state a rebuild (or a live mclk-set left in place) can change without
        # touching this SM receipt, and more DRAM speed is the classic silent-corruption regime. A
        # receipt earned at one memory clock is not evidence about another.
        say "${c_bad}memory clock changed since this point was gated: receipt ${rec_mclk} MHz, card now ${live_mclk} MHz.${c_off}"
        say "  a gate proves the offset AND the memory clock it ran at - it is not evidence about a different one."
        say "  re-gate at the current clock:  170tune gate $off $clk 4"
        [ "$force" = 1 ] || return 1
        say "${c_warn}  --force: persisting across a memory-clock change anyway${c_off}"
    elif [ "${peak:-0}" -lt "$GATE_TEMP" ]; then
        say "${c_warn}cold receipt: +$off/$clk was gated with HBM peaking at only ${peak}C (want ${GATE_TEMP}C).${c_off}"
        say "  hot silicon needs more voltage, so an undervolt that passes cold can corrupt hot."
        say "  re-gate hot:  GATE_SOAK_MAX=300 170tune gate $off $clk 4"
        [ "$force" = 1 ] || return 1
        say "${c_warn}  --force: persisting on a cold gate anyway${c_off}"
    else
        say "${c_ok}gate receipt found: +$off/$clk passed $sweeps sweeps at ${peak}C HBM on this card${c_off}"
        sed 's/^/            /' "$rf"
        if ! grep -q '"workload": "' "$rf"; then
            say "${c_warn}  this receipt is sweeps + GEMM only - no real workload was run against it.${c_off}"
            say "${c_warn}  before you rely on it in production:  170tune gate $off $clk 4 --workload '<your command>'${c_off}"
        else
            say "${c_warn}  the workload on this receipt was:  $(grep -oE '"workload": "[^"]*"' "$rf" | cut -d'"' -f4)${c_off}"
            say "${c_warn}  if that is not the engine that will serve, it is closer to no workload than to a real one.${c_off}"
        fi
    fi
    return 0
}

# HARDWARE-TEST-GATED SECTION (persist unification). cmd_persist is the single unified
# persistence command for BOTH the SM point (offset/clk) and the HBM point (NDIV/timings) - one
# conf per serial under $PERSIST, one systemd unit (170tune-persist.service via boot-apply below)
# that re-applies whatever is in it. Named SM profiles are pure sugar over this: '--profile eff'
# resolves to a concrete offset/ceiling via profile_point() at SAVE time and is recorded as a
# comment for humans, never re-resolved at boot (boot-apply only ever reads raw numbers).
cmd_persist() {
    local sub=${1:-status}; shift 2>/dev/null || true
    local s; s=$(serial)
    case "$sub" in
        save)
            need_root persist save "$@"
            [ -n "$s" ] || die "no serial - is a card installed?"
            refuse_if_mclk_baked "persist save"
            mkdir -p "$PERSIST"
            local ndiv="" off="" clk="" tim="" profname="" force=0
            while [ $# -ge 1 ]; do case "$1" in
                --ndiv) ndiv=$2; shift 2 ;; --offset) off=$2; shift 2 ;;
                --clk) clk=$2; shift 2 ;; --timings) tim=$2; shift 2 ;;
                --profile) profname=$2; shift 2 ;;
                -f|--force) force=1; shift ;;
                *) die "unknown arg '$1' (use --profile NAME | --offset O --clk C, plus --ndiv N --timings \"F v ...\", -f/--force)" ;;
            esac; done
            if [ -n "$profname" ]; then
                read -r off clk _ < <(profile_point "$profname")
                [ -n "${off:-}" ] || die "unknown profile '$profname' - see '170tune --help' for the list, or use --offset/--clk directly"
                say "resolved profile '$profname' -> offset +$off, ceiling $clk"
            fi
            if [ -n "${off:-}" ] && [ -n "${clk:-}" ]; then
                sm_receipt_gate "$off" "$clk" "$force" || die "refusing to persist an unproven SM point (see above); use --force to override"
            fi
            { echo "# 170tune persist profile for $s ($(date -Is)) - only GATED values belong here"
              echo "NDIV=${ndiv}"; echo "OFFSET=${off}"; echo "CLK=${clk}"; echo "TIMINGS=\"${tim}\""
              [ -n "$profname" ] && echo "# profile: $profname"
            } > "$PERSIST/$s.conf"
            say "${c_ok}saved $PERSIST/$s.conf${c_off}"; sed 's/^/   /' "$PERSIST/$s.conf"
            say "enable at boot with: 170tune persist enable"
            ;;
        enable)
            need_root persist enable
            [ -f "$PERSIST/$s.conf" ] || die "no profile for $s yet - run 'persist save' first"
            install_persist_unit
            systemctl daemon-reload; systemctl enable 170tune-persist.service >/dev/null 2>&1
            say "${c_ok}170tune-persist.service enabled - the qualified profile re-applies each boot${c_off}"
            say "  recover remotely if a profile misbehaves: systemctl mask 170tune-persist.service (boot stays stock)"
            ;;
        disable)
            need_root persist disable
            systemctl disable 170tune-persist.service >/dev/null 2>&1
            say "persist service disabled (profile kept at $PERSIST/$s.conf)"
            ;;
        status|*)
            if [ -f "$PERSIST/$s.conf" ]; then say "profile for $s:"; sed 's/^/   /' "$PERSIST/$s.conf"; else say "no persist profile for $s"; fi
            systemctl is-enabled 170tune-persist.service 2>/dev/null | sed 's/^/service enabled: /'
            if [ -n "$s" ] && [ -d "$STATE/quarantine/$s" ] && [ -n "$(ls -A "$STATE/quarantine/$s" 2>/dev/null)" ]; then
                say "${c_warn}quarantined on this card (persist save refuses these without --force):${c_off}"
                ls -1 "$STATE/quarantine/$s" | sed 's/^/   /'
            fi
            ;;
    esac
}

# ExecStart of the persist service. Self-disarming: if a marker from a PRIOR boot
# survived, the last apply went down with the box - stay STOCK, do not re-apply.
cmd_boot_apply() {
    need_root boot-apply
    local s; s=$(serial)
    local conf="$PERSIST/$s.conf"
    [ -f "$conf" ] || { logger -t 170tune "boot-apply: no profile for ${s:-unknown}, staying stock"; exit 0; }
    # boot-check (runs Before= us) sets this flag, keyed to this boot_id, when it detected a
    # mid-flight crash and reverted to stock. Honor it: do NOT re-apply the profile that may have
    # caused the crash. A flag from a prior boot has a different id and is cleared as stale.
    if [ -f "$STATE/persist-skip-boot" ]; then
        local sb; sb=$(cat "$STATE/persist-skip-boot" 2>/dev/null)
        rm -f "$STATE/persist-skip-boot"
        if [ "$sb" = "$(cat /proc/sys/kernel/random/boot_id)" ]; then
            logger -t 170tune "boot-apply: boot-check flagged a mid-flight crash this boot - staying STOCK (see $STATE/last_crash.json)"
            exit 0
        fi
    fi
    if [ -f "$STATE/armed.json" ]; then
        local ab tb; ab=$(grep -oE '"boot_id": "[^"]+"' "$STATE/armed.json" | cut -d'"' -f4); tb=$(cat /proc/sys/kernel/random/boot_id)
        if [ "$ab" != "$tb" ]; then
            { echo "{\"skipped\":\"$(date -Is)\",\"note\":\"persist apply was in flight when the box went down; staying stock\",\"armed\":"; cat "$STATE/armed.json"; echo "}"; } > "$STATE/last_crash.json"
            disarm
            logger -t 170tune "boot-apply: prior apply did not check in - staying STOCK (see $STATE/last_crash.json)"
            exit 0
        fi
    fi
    # shellcheck disable=SC1090
    . "$conf"
    arm "persist-$s" "${NDIV:-0}"
    logger -t 170tune "boot-apply: applying $s NDIV=${NDIV:-} offset=${OFFSET:-} clk=${CLK:-} timings=${TIMINGS:-}"
    [ -n "${OFFSET:-}" ] && "$NVML" "${OFFSET}" 0 >/dev/null 2>&1
    [ -n "${CLK:-}" ] && nvidia-smi -lgc "210,${CLK}" >/dev/null 2>&1
    if [ -n "${TIMINGS:-}" ] && [ -x "$FBPA_REGS" ]; then
        # shellcheck disable=SC2086
        set -- ${TIMINGS}; while [ $# -ge 2 ]; do "$FBPA_REGS" set "$1" "$2" >/dev/null 2>&1; shift 2; done
    fi
    if [ -n "${NDIV:-}" ] && [ "${NDIV}" != "$STOCK_NDIV" ] && [ -x "$HBM_MCLK" ]; then
        if "$HBM_MCLK" set "${NDIV}" >/dev/null 2>&1; then
            # Bare NDIV by default (robust). The DDLL recal is opt-in and non-deterministic; only
            # apply it when the persisted profile is a recal-extended (>bare-ceiling) point.
            [ -n "${MCLK_RECAL:-}" ] && "$HBM_MCLK" ddll >/dev/null 2>&1
        else
            logger -t 170tune "boot-apply: NDIV ${NDIV} did not lock; left stock"
        fi
    fi
    sleep 2
    if wedged || [ "$(xids)" -gt 0 ]; then
        logger -t 170tune "boot-apply: post-apply health check FAILED; reverting to stock"
        "$NVML" 0 0 >/dev/null 2>&1; nvidia-smi -rgc >/dev/null 2>&1; mclk_revert
        disarm; exit 1
    fi
    disarm
    logger -t 170tune "boot-apply: profile $s applied and healthy"
}

# --------------------------------------------------------------- migration (HARDWARE-TEST-GATED)
# Runs once, from inside 'install'. Earlier versions of this tool persisted an SM profile with a
# static 170hx-oc.service unit reading /etc/170tune/profile (PROFILE=/OC_OFFSET=/OC_CLK=). That
# model is retired in favour of the unified boot-apply above (persist save/enable,
# /var/lib/170tune/persist/<serial>.conf, 170tune-persist.service), which also covers the HBM
# NDIV/timings this tool now owns. A box upgrading from the old model must never end up on BOTH -
# never a boot with 170hx-oc.service AND 170tune-persist.service enabled at once, or the two would
# race to apply (or double-apply) the same point. So: disable the old unit FIRST, only then enable
# the new one, and print exactly what moved - nothing here is silent.
migrate_old_persist() {
    local old_conf="/etc/170tune/profile" old_unit="170hx-oc.service"
    [ -f "$old_conf" ] || return 0
    systemctl is-enabled "$old_unit" >/dev/null 2>&1 || return 0
    say "${c_hi}migrating old persist model ($old_conf, $old_unit) to the unified persist${c_off}"
    local prof off clk s
    prof=$(grep -oE '^PROFILE=.*' "$old_conf" | cut -d= -f2)
    off=$(grep -oE '^OC_OFFSET=.*' "$old_conf" | cut -d= -f2)
    clk=$(grep -oE '^OC_CLK=.*' "$old_conf" | cut -d= -f2)
    s=$(serial)
    if [ -z "$s" ]; then
        say "${c_bad}  migration aborted: no serial - is a card installed? Re-run '170tune install' with the card present.${c_off}"
        return 1
    fi
    if [ -z "${off:-}" ] || [ -z "${clk:-}" ]; then
        read -r off clk _ < <(profile_point "${prof:-eff}")
    fi
    if [ -z "${off:-}" ] || [ -z "${clk:-}" ]; then
        say "${c_bad}  migration aborted: could not resolve $old_conf (PROFILE=${prof:-?}) to an offset/clock. Left $old_unit as-is.${c_off}"
        return 1
    fi
    mkdir -p "$PERSIST"
    { echo "# 170tune persist profile for $s ($(date -Is)) - migrated from $old_conf"
      echo "NDIV="; echo "OFFSET=${off}"; echo "CLK=${clk}"; echo "TIMINGS="
      [ -n "${prof:-}" ] && echo "# profile: ${prof}"
    } > "$PERSIST/$s.conf"
    say "  wrote $PERSIST/$s.conf: offset=+$off clk=$clk${prof:+ (profile: $prof)}"
    systemctl disable --now "$old_unit" >/dev/null 2>&1
    say "  disabled $old_unit (its ExecStop reverted the card to stock)"
    install_persist_unit
    systemctl daemon-reload
    systemctl enable 170tune-persist.service >/dev/null 2>&1
    say "  enabled 170tune-persist.service"
    mv "$old_conf" "${old_conf}.migrated"
    say "  renamed $old_conf -> ${old_conf}.migrated"
    say "${c_ok}migration complete: profile ${prof:-custom} (offset +$off, clk $clk) now applies via 170tune-persist.service${c_off}"
    say "  it was NOT re-applied automatically - run '170tune persist status' to check, and"
    say "  '170tune status' to see what the card is actually running right now."
}

# --------------------------------------------------------------- setup / portability
# Everything below exists to make 170tune usable on ANOTHER card/box, not just the one it was
# written on: build+install the helper tools from source, check a fresh box is actually ready
# to tune, and stop hardcoding one card's stock values as the revert target for every card.

# Build one tool into $tmp and install it to $prefix. $1=name $2=compiler(gcc or an nvcc path)
# $3=prefix $4=tmp $5=src, remaining args are extra compiler flags. Prints [ok]/[FAIL] and
# returns 0/1 so the caller can tally a summary without the two of them sharing global state.
_install_build() {
    local name=$1 cc=$2 prefix=$3 tmp=$4 src=$5; shift 5
    if [ ! -f "$src" ]; then
        say "${c_bad}[FAIL] $name: source not found at $src${c_off}"
        return 1
    fi
    local err
    err=$("$cc" -O2 -o "$tmp/$name" "$src" "$@" 2>&1)
    if [ ! -x "$tmp/$name" ]; then
        say "${c_bad}[FAIL] $name: $(printf '%s' "$err" | tail -3 | tr '\n' ' ')${c_off}"
        return 1
    fi
    # Unlink the old target first, then install the fresh build. Overwriting a binary that is
    # currently executing fails with ETXTBSY; unlinking drops the old inode (a running process
    # keeps its copy) so the upgrade is clean. Source lives in $tmp, never the target, so this is safe.
    rm -f "$prefix/$name" 2>/dev/null
    if install -m 755 "$tmp/$name" "$prefix/$name" 2>/dev/null; then
        say "${c_ok}[ok] $name${c_off}"
        return 0
    fi
    say "${c_bad}[FAIL] $name: built but could not install to $prefix${c_off}"
    return 1
}

# install: build every helper tool from source and install them (+ this script, the shipped
# scripts, and the boot-check unit) to a prefix (default /usr/local/bin). Makes 170tune usable on
# a card/box other than the one it was written on: find_tool and the persist boot service both
# look in /usr/local/bin first, so installing there needs no extra config (no PATH, HOME or
# SUDO_USER to get right). Idempotent - safe to re-run after a git pull. gcc tools are required;
# nvcc tools are best-effort, since a box that only measures may never need to build CUDA (gate
# needs gpu_selftest though, so a missing nvcc is a loud warning, not a silent skip). Also runs
# the old-persist-model migration (see migrate_old_persist above) - always, every run, since it
# is a no-op unless the old unit is actually enabled.
cmd_install() {
    local prefix=${1:-/usr/local/bin}
    mkdir -p "$prefix" 2>/dev/null || die "cannot create $prefix"
    local D; D=$(dirname "$SELF")
    # install builds every helper FROM SOURCE, so it must run from the source checkout (the tools/
    # dir alongside this script), never the installed copy. Invoked as the PATH binary
    # ('170tune install' -> /usr/local/bin/170tune), $D is the install prefix, which holds no
    # *.c/*.cu - fail LOUDLY with the fix instead of half-installing (and, worse, unlinking the
    # co-located scripts below). The normal path './install.sh' resolves $D to the checkout's tools/.
    if [ ! -f "$D/hbm_mclk.c" ]; then
        die "install must run from the 170tune source checkout, not the installed copy.
  cd into the repo you git-pulled and run:  ./install.sh   (or ./tools/170tune install)
  (invoked as '$SELF'; its dir '$D' has no tool sources.)"
    fi
    local tmp; tmp=$(mktemp -d) || die "cannot create a temp build dir"
    local ok=0 fail=0

    # Locate a CUDA toolkit: PATH first, then the common install roots (nvcc is often not on
    # PATH even when the toolkit is present - e.g. an /opt/cuda install with no /etc/profile.d
    # entry). Needed both to build the .cu tools AND for nvml.h, which nvml_oc.c needs even
    # though it is a plain gcc build - the header only ships inside the CUDA toolkit here, gcc
    # does not know where to find it on its own (nvcc does, automatically).
    local cuda_root="" nvcc_bin=""
    if command -v nvcc >/dev/null 2>&1; then
        nvcc_bin=$(command -v nvcc); cuda_root=$(dirname "$(dirname "$nvcc_bin")")
    else
        local c; for c in /opt/cuda /usr/local/cuda /usr/lib/cuda; do
            [ -x "$c/bin/nvcc" ] && { cuda_root=$c; nvcc_bin="$c/bin/nvcc"; break; }
        done
    fi

    say "${c_hi}building gcc tools -> $prefix${c_off}"
    _install_build hbm_mclk  gcc "$prefix" "$tmp" "$D/hbm_mclk.c" && ok=$((ok+1)) || fail=$((fail+1))
    _install_build fbpa_regs gcc "$prefix" "$tmp" "$D/fbpa_regs.c" && ok=$((ok+1)) || fail=$((fail+1))
    if [ -n "$cuda_root" ]; then
        _install_build nvml_oc gcc "$prefix" "$tmp" "$D/nvml_oc.c" "-I$cuda_root/include" -lnvidia-ml && ok=$((ok+1)) || fail=$((fail+1))
    else
        _install_build nvml_oc gcc "$prefix" "$tmp" "$D/nvml_oc.c" -lnvidia-ml && ok=$((ok+1)) || fail=$((fail+1))
    fi

    if [ -n "$nvcc_bin" ]; then
        say "${c_hi}building cuda tools -> $prefix (nvcc: $nvcc_bin)${c_off}"
        _install_build gpu_selftest  "$nvcc_bin" "$prefix" "$tmp" "$D/gpu_selftest.cu"  -arch=sm_80 && ok=$((ok+1)) || fail=$((fail+1))
        _install_build compute_check "$nvcc_bin" "$prefix" "$tmp" "$D/compute_check.cu" -arch=sm_80 -lcublas && ok=$((ok+1)) || fail=$((fail+1))
        _install_build oc_eff        "$nvcc_bin" "$prefix" "$tmp" "$D/oc_eff.cu"        -arch=sm_80 -lcublas -lnvidia-ml && ok=$((ok+1)) || fail=$((fail+1))
        _install_build mem_probe     "$nvcc_bin" "$prefix" "$tmp" "$D/mem_probe.cu"     -arch=sm_80 && ok=$((ok+1)) || fail=$((fail+1))
        _install_build gemm_probe    "$nvcc_bin" "$prefix" "$tmp" "$D/gemm_probe.cu"    -arch=sm_80 -lcublas && ok=$((ok+1)) || fail=$((fail+1))
        _install_build ctx_probe     "$nvcc_bin" "$prefix" "$tmp" "$D/ctx_probe.cu"     -arch=sm_80 && ok=$((ok+1)) || fail=$((fail+1))
        _install_build nvidia_bench  "$nvcc_bin" "$prefix" "$tmp" "$D/nvidia_bench.cu" \
            -lnvidia-ml -ldl \
            -gencode arch=compute_75,code=sm_75 -gencode arch=compute_80,code=sm_80 \
            -gencode arch=compute_86,code=sm_86 -gencode arch=compute_89,code=sm_89 \
            -gencode arch=compute_90,code=sm_90 && ok=$((ok+1)) || fail=$((fail+1))
    else
        say "${c_warn}[warn] nvcc not found - skipping gpu_selftest/compute_check/oc_eff/mem_probe/gemm_probe/ctx_probe/nvidia_bench"
        say "${c_warn}       (needed for 'gate'/'mclk-gate'/'recover'); install the CUDA toolkit and re-run${c_off}"
    fi

    say "${c_hi}installing scripts -> $prefix${c_off}"
    # Route the script through $tmp before unlinking the target: if 170tune is being run FROM
    # $prefix (installing over itself), $SELF and the target are the same path - copying to $tmp
    # first means the unlink cannot destroy the source, and bash keeps reading the old inode.
    if [ -f "$SELF" ] && cp "$SELF" "$tmp/170tune" 2>/dev/null; then
        rm -f "$prefix/170tune" 2>/dev/null
        install -m 755 "$tmp/170tune" "$prefix/170tune" 2>/dev/null && { say "${c_ok}[ok] 170tune${c_off}"; ok=$((ok+1)); } \
            || { say "${c_bad}[FAIL] 170tune: could not install to $prefix${c_off}"; fail=$((fail+1)); }
    else
        say "${c_bad}[FAIL] 170tune: source not found at $SELF${c_off}"; fail=$((fail+1))
    fi
    local extra
    for extra in 170hx-oc 170hx-sweep 170hx-soak vllm_workload_check.sh; do
        if [ -f "$D/$extra" ] && cp "$D/$extra" "$tmp/$extra" 2>/dev/null; then
            # Route through $tmp before unlinking, exactly as the 170tune script above: if $prefix
            # equals $D the source and target are the same path, so unlinking first would delete
            # the source. Copying to $tmp makes the unlink safe.
            rm -f "$prefix/$extra" 2>/dev/null
            install -m 755 "$tmp/$extra" "$prefix/$extra" 2>/dev/null && { say "${c_ok}[ok] $extra${c_off}"; ok=$((ok+1)); } \
                || { say "${c_bad}[FAIL] $extra: could not install to $prefix${c_off}"; fail=$((fail+1)); }
        else
            say "${c_bad}[FAIL] $extra: source not found at $D/$extra${c_off}"; fail=$((fail+1))
        fi
    done

    if [ -d /etc/systemd/system ]; then
        local svcsrc="$D/../systemd/170tune-bootcheck.service"
        if [ -f "$svcsrc" ]; then
            install -m 644 "$svcsrc" /etc/systemd/system/170tune-bootcheck.service 2>/dev/null \
                && { say "${c_ok}[ok] 170tune-bootcheck.service (enabled)${c_off}"
                     systemctl daemon-reload 2>/dev/null; systemctl enable 170tune-bootcheck.service 2>/dev/null
                     ok=$((ok+1)); } \
                || { say "${c_bad}[FAIL] 170tune-bootcheck.service: could not install${c_off}"; fail=$((fail+1)); }
        else
            say "${c_warn}[warn] 170tune-bootcheck.service source not found at $svcsrc - skipping${c_off}"
        fi
    fi

    rm -rf "$tmp"
    say ""
    say "installed to $prefix: $ok ok, $fail failed"
    say "installing to /usr/local/bin (the default) means find_tool and the 170tune-persist boot"
    say "service locate every tool with no extra config - PATH, HOME and SUDO_USER all stop mattering."

    migrate_old_persist

    say "next: 170tune preflight"
    [ "$fail" -eq 0 ]
}

# preflight: read-only checklist for standing this tool up on another card/box. Every check is
# guarded with -x/command tests so a fresh checkout with no tools built yet reports cleanly
# instead of crashing on the first missing binary. Exit 0 = ready to tune, 1 = something to fix.
cmd_preflight() {
    local hard_fail=0 hw_checked=0
    say "${c_hi}170tune preflight${c_off}"

    if is_170hx; then
        say "${c_ok}[ok]${c_off}   GPU 0 is a CMP 170HX (device id $(devid))"
    else
        say "${c_bad}[FAIL]${c_off} GPU 0 is a CMP 170HX"
        say "       GPU 0 device id $(devid) is not a 170HX"
        hard_fail=1
    fi

    if nvidia-smi >/dev/null 2>&1; then
        say "${c_ok}[ok]${c_off}   nvidia driver responds"
    else
        say "${c_bad}[FAIL]${c_off} nvidia driver responds"
        say "       nvidia driver not responding - is it loaded? (modprobe nvidia)"
        hard_fail=1
    fi

    if [ -x "$HBM_MCLK" ] && [ -x "$FBPA_REGS" ] && [ -x "$SELFTEST" ]; then
        say "${c_ok}[ok]${c_off}   helper tools present (hbm_mclk, fbpa_regs, gpu_selftest)"
    else
        say "${c_bad}[FAIL]${c_off} helper tools present"
        say "       helper tools not found - run: 170tune install"
        hard_fail=1
    fi

    # MCLK MISCLASSIFICATION GUARD. Check this even before the BAR0/root checks below: a driver
    # baked with a non-stock mclk is a correctness problem no amount of BAR0/unlock access fixes,
    # and every command it would block (snapshot-stock, mclk-try/gate, persist save) is exactly
    # what a fresh preflight is about to send the user toward.
    case "$(mclk_source)" in
        driver-baked*)
            say "${c_bad}[FAIL]${c_off} memory clock source (driver-baked, unsupported for tuning)"
            say "       $(mclk_source) - the driver's own idea of \"current\" mclk is already non-stock,"
            say "       most likely built with cmpunlocker's --mclk-ndiv. snapshot-stock, mclk-try/mclk-gate"
            say "       and persist save all refuse on this driver: rebuild a stock driver and use this"
            say "       tool's userspace mclk control (mclk-try/mclk-gate) instead."
            hard_fail=1
            ;;
        unknown) say "${c_warn}[warn]${c_off} memory clock source - could not read nvidia-smi's mclk; skipping the check" ;;
        *) say "${c_ok}[ok]${c_off}   memory clock source: $(mclk_source)" ;;
    esac

    # BAR0 + PLM both need to READ registers, which requires root (the BAR0 mmap). Without root
    # a failed read means nothing about iomem/unlock, so do not emit a hardware FAIL - tell the
    # user to re-run with sudo. Only claim an iomem/PLM problem when we actually are root.
    if [ "$(id -u)" -ne 0 ]; then
        say "${c_warn}[warn]${c_off} BAR0 access + FBPA privilege masks"
        say "       these probe BAR0 registers and need root - re-run: sudo 170tune preflight"
    elif [ ! -x "$FBPA_REGS" ]; then
        say "${c_warn}[warn]${c_off} BAR0 access + FBPA privilege masks"
        say "       fbpa_regs not found - cannot check (run: 170tune install)"
    else
        hw_checked=1
        local r4; r4=$("$FBPA_REGS" read 0x009A0290 2>&1)
        if printf '%s' "$r4" | grep -qE '= 0x[0-9A-Fa-f]+'; then
            say "${c_ok}[ok]${c_off}   BAR0 access (iomem)"
        else
            say "${c_bad}[FAIL]${c_off} BAR0 access (iomem)"
            say "       cannot mmap BAR0 - add iomem=relaxed to the kernel cmdline (GRUB CMDLINE), update-grub, reboot"
            hard_fail=1
        fi
        # FBPA privilege masks (the cmpunlocker unlock target). Mirrors hbm_mclk.c's own guard:
        # PLM_WRITE_L0 = bit 0x10 means host (level-0) writes are enabled; some cards read back
        # all-ones (0xFFFFFFFF) instead, also open. Anything else means writes get silently dropped.
        local p1 p2 open1=0 open2=0
        p1=$("$FBPA_REGS" read 0x00903C7C 2>/dev/null | awk '{print $NF}')
        p2=$("$FBPA_REGS" read 0x009A0168 2>/dev/null | awk '{print $NF}')
        case "$p1" in 0xFFFFFFFF|0xffffffff) open1=1 ;; 0x*|[0-9]*) [ "$(( p1 & 0x10 ))" -ne 0 ] 2>/dev/null && open1=1 ;; esac
        case "$p2" in 0xFFFFFFFF|0xffffffff) open2=1 ;; 0x*|[0-9]*) [ "$(( p2 & 0x10 ))" -ne 0 ] 2>/dev/null && open2=1 ;; esac
        if [ -z "$p1" ] || [ -z "$p2" ]; then
            say "${c_warn}[warn]${c_off} FBPA privilege masks (unlock)"
            say "       could not read PLM registers - check BAR0 access above"
        elif [ "$open1" -eq 1 ] && [ "$open2" -eq 1 ]; then
            say "${c_ok}[ok]${c_off}   FBPA privilege masks open (PLL PLM $p1, MEM PLM $p2)"
        else
            say "${c_bad}[FAIL]${c_off} FBPA privilege masks (unlock)"
            say "       FBPA privilege masks are closed - host register writes will be dropped. Apply the cmpunlocker unlock (patched driver / hammer service) and retry"
            hard_fail=1
        fi
    fi

    local ndiv=""
    [ -x "$HBM_MCLK" ] && ndiv=$("$HBM_MCLK" get 2>/dev/null | grep -oE 'NDIV [0-9]+' | grep -oE '[0-9]+' | head -1)
    local s; s=$(serial 2>/dev/null)
    local snap="none"
    [ -n "$s" ] && [ -f "$STATE/stock/$s.conf" ] && snap="$STATE/stock/$s.conf"
    say "info    current NDIV: ${ndiv:-unknown}   per-card stock snapshot: $snap"

    if [ "$hard_fail" -eq 0 ]; then
        if [ "$hw_checked" -eq 1 ]; then
            say "${c_ok}preflight OK - ready to tune${c_off}"
        else
            say "${c_warn}preflight OK so far - re-run with sudo to verify BAR0 access + the unlock before tuning${c_off}"
        fi
        return 0
    fi
    say "${c_bad}preflight FAILED - fix the items above before tuning${c_off}"
    return 1
}

# snapshot-stock: read THIS card's current values (assumed to be at stock) and write a
# per-serial override for STOCK_NDIV/STOCK_REFRESH/STOCK_TIMINGS. The hardcoded STOCK_*
# defaults near the top of this file were measured on one card's VBIOS; a different card can
# ship different stock counts, and hardcoding one card's numbers as everyone's revert target
# is wrong. Run this ONCE, before ever touching mclk/timings/refresh on a new card.
cmd_snapshot_stock() {
    [ -x "$HBM_MCLK" ] || die "hbm_mclk not found at $HBM_MCLK - run: 170tune install"
    [ -x "$FBPA_REGS" ] || die "fbpa_regs not found at $FBPA_REGS - run: 170tune install"
    refuse_if_mclk_baked "snapshot-stock"
    local s; s=$(serial); [ -n "$s" ] || die "no serial - is a card installed?"

    local ndiv; ndiv=$("$HBM_MCLK" get 2>/dev/null | grep -oE 'NDIV [0-9]+' | grep -oE '[0-9]+' | head -1)
    [ -n "$ndiv" ] || die "could not read current NDIV from hbm_mclk get"
    local refresh; refresh=$("$FBPA_REGS" get REFRESH 2>/dev/null)
    [ -n "$refresh" ] || die "could not read REFRESH from fbpa_regs get"

    local kv f v rebuilt=""
    for kv in $STOCK_TIMINGS; do
        f=${kv%:*}
        v=$("$FBPA_REGS" get "$f" 2>/dev/null)
        if [ -z "$v" ]; then
            say "${c_warn}[warn] skipping field $f - fbpa_regs cannot read it (not a known field on this card)${c_off}"
            continue
        fi
        rebuilt="$rebuilt $f:$v"
    done
    rebuilt=${rebuilt# }

    # Premise-free poisoned-reference guard. A 170HX at true stock is NDIV 64; anything above the
    # stock range means the card is tuned OR the driver was baked with --mclk-ndiv (which sets the
    # PLL COEFF at module load, so hbm_mclk reads it back here directly - no reliance on whether
    # nvidia-smi reflects it). Capturing that as "stock" would poison the reference every gate and
    # every self-disarm falls back to, so refuse rather than warn. This backstops refuse_if_mclk_baked.
    if [ "${ndiv:-0}" -gt 66 ] 2>/dev/null; then
        die "refusing snapshot-stock: current NDIV is $ndiv, not stock ($STOCK_NDIV). The card is tuned or the driver is baked with --mclk-ndiv; snapshotting now would poison the stock reference. Revert to stock (170tune reset; rebuild a stock driver if it was baked; reboot), then re-run."
    fi

    mkdir -p "$STATE/stock"
    local out="$STATE/stock/$s.conf"
    { echo "# 170tune per-card stock snapshot for $s ($(date -Is)) - read live, overrides the"
      echo "# hardcoded STOCK_* defaults near the top of 170tune for THIS serial only."
      echo "STOCK_NDIV=$ndiv"
      echo "STOCK_REFRESH=$refresh"
      echo "STOCK_TIMINGS=\"$rebuilt\""
    } > "$out"
    say "${c_ok}saved $out${c_off}"
    sed 's/^/   /' "$out"
}

cmd_help() {
cat <<'EOF'
170tune - measure, qualify and recover clock/voltage settings on a CMP 170HX

USAGE
  170tune <command> [args]

COMMANDS
  explain                     the SM clock/voltage levers, the two regimes, failure modes. Start here.
  explain-hbm                 the HBM memory levers: clock, timings, the data eye, refresh.
  status                      what the card is set to now, plus any armed marker or crash record.
  try     <off> <clk> [secs]  apply one point and measure it. Prints UNVERIFIED: completing a
                              benchmark is exactly what silent corruption looks like.
  gate    <off> <clk> [n] [--workload <cmd>]
                              the proof. Soaks the card to GATE_TEMP, then runs n full-VRAM
                              pattern sweeps plus a bit-exact compute check. Exit 0 = gated,
                              1 = rejected. NECESSARY BUT NOT SUFFICIENT: sweeps and a dense
                              GEMM are a narrower instruction mix than a real application, and
                              three profiles that passed this gate on the reference card killed
                              an inference server within seconds. --workload runs YOUR command
                              as the last rung and records that it survived. Make it the engine
                              that will actually SERVE: a rung running a different engine
                              certifies the point against a load it will never see, and can
                              reject a good point over a fault only that engine has. There is a
                              worked vLLM rung in vllm_workload_check.sh - copy its shape.
                              A passing gate writes a per-serial receipt that 'persist save'
                              later demands before it will let the point survive a reboot.
  quarantine <off> <clk> --reason "..."
                              record a point as known-bad on this card - the thing the gate
                              missed. 'persist save' then refuses it even with a passing receipt.
  quarantine list             what is quarantined here.  unquarantine <off> <clk> clears one.
  ladder  <clk> [start] [step] [max]
                              walk the offset up at one ceiling, gating each rung, and stop at
                              the first rung that runs but fails the gate. Prints the highest
                              gated offset. Ship BELOW it, not at it.
  qualify [clk]                the whole per-card flow, recorded to
                              /var/lib/170tune/results/<serial>/oc.json. Changes nothing
                              permanently - adopting a result is a separate, deliberate step.
  selftest [--physical]       prove the detectors still work before trusting any PASS.
  apply   <profile>           make a named profile live NOW (see PROFILES). Not persistent by
                              itself - see PERSISTENCE below.
  reset                       back to stock: offset 0, no clock lock, 250 W.
  recover                     after a fault or hang: clear offsets and locks, reload the driver
                              if the card is wedged, and escalate honestly to reboot or power
                              cycle if that does not work. It will not call the card recovered
                              until a CUDA context can actually be created on it - the card can
                              answer nvidia-smi perfectly while every process fails to get one.
  boot-check                  systemd oneshot. If a tuning run did not check in before the
                              machine went down, revert to stock and record what was in flight.

SETUP (getting this tool running on another card/box)
  install [prefix]              build every helper tool from source and install them + this
                              script + 170hx-oc/170hx-sweep/170hx-soak/vllm_workload_check.sh +
                              the boot-check unit to prefix (default /usr/local/bin). Idempotent
                              - safe to re-run. gcc tools (hbm_mclk, fbpa_regs, nvml_oc) are
                              required; the CUDA tools are best-effort - a missing nvcc is a
                              loud warning, not a silent skip. Also migrates a box still on the
                              old 170hx-oc.service persist model to the unified persist below,
                              printing exactly what it moved (never silent).
  preflight                    read-only checklist before tuning a new card: card identity,
                              driver, tools present, memory clock is stock (not driver-baked -
                              see the mclk misclassification guard under 'explain-hbm'), BAR0
                              access, FBPA privilege masks (unlock) open. Exit 0 = ready.
  snapshot-stock                read THIS card's current values (assumed stock) and save a
                              per-serial override for STOCK_NDIV/STOCK_REFRESH/STOCK_TIMINGS
                              to /var/lib/170tune/stock/<serial>.conf. Run once, before ever
                              touching mclk/timings/refresh on a card whose stock was not
                              measured by the hardcoded defaults near the top of this file.
                              Refuses on a driver-baked non-stock mclk (see 'explain-hbm').

HBM MEMORY LEVERS (live userspace BAR0 - no driver rebuild; the unlock opens the PLMs)
  Run 'explain-hbm' for the full model, including the mclk misclassification guard: a driver
  compiled with cmpunlocker's --mclk-ndiv is a DIFFERENT thing from this tool's live NDIV
  control, and 170tune refuses to tune on top of one (mclk-try/gate/ladder, snapshot-stock,
  and persist save all check and refuse). A hung CUDA context during mclk-gate/timings-gate is
  treated as a gate failure, same as on the SM side - see 'explain'.
  mclk-status                 current HBM NDIV / MHz / PLL lock / PLM state (via hbm_mclk).
  mclk-try   <NDIV>           set the HBM clock live (NDIV*27 MHz), prove it moved. UNVERIFIED.
  mclk-gate  <NDIV> [n]       the proof: core pinned stock, n hot full-VRAM sweeps + compute.
                              A cold gate is a FAILURE - HBM silent corruption is temp-dependent.
  mclk-ladder [start] [step] [max]
                              walk NDIV up (default 65 1 80), gate each rung hot, stop at the
                              first that runs but fails the gate. Leaves the card on the highest
                              GATED NDIV (volatile). Ship one below; persist to keep it.
  hbm-matrix [start] [step] [max]
                              the bandwidth-per-NDIV measurement matrix (read/copy/triad), the
                              companion to mclk-ladder like the GPC GEMM matrix is to its
                              qualification. FAST + UNVERIFIED - a row is bandwidth, not safety.
                              Appends to /var/lib/170tune/hbm_matrix_<serial>.csv.
  timings [dump|get|set|save|load] ...   drive the DRAM CONFIG timings via fbpa_regs.
  timings-gate <FIELD> <cyc> [n]         set a timing and prove it hot (same gate as mclk).
  refresh {status|set <us>|gate <us> [n]|stock}
                              the refresh power/heat lever (retention <-> power <-> bandwidth).
                              Looser interval = less power/heat, at the cost of retention.
                              Ships OPT-IN and MODERATE: 'gate' proves an interval HOT on this
                              card. Persist via persist save --timings "REFRESH <f>".

PERSISTENCE (one unified conf per serial + one systemd unit; boot-apply is the single applier)
  persist save [--profile NAME] [--offset O --clk C] [--ndiv N] [--timings "F v ..."] [-f|--force]
                              record the per-serial profile that boot-apply will re-apply. A
                              named SM profile is sugar: --profile eff resolves to its concrete
                              offset/ceiling right here (via 170hx-oc --print) and is written
                              as a comment for humans; boot-apply itself only ever reads raw
                              numbers. An SM point (--offset/--clk, or one resolved from
                              --profile) is refused unless this card has a passing gate receipt
                              for it (not quarantined, >=4 sweeps, hot, current memory clock) -
                              -f/--force overrides, loudly. HBM values (--ndiv/--timings) are
                              not receipt-gated the same way; gate them yourself first.
                              Refuses outright on a driver-baked non-stock mclk (see 'explain-hbm').
  persist enable | disable    install/enable (or disable) 170tune-persist.service.
  persist status              show the profile, whether the service is enabled, and any
                              quarantined points on this card.
  boot-apply                  (systemd) ExecStart of the persist service. Self-disarming: if a
                              prior boot's apply did not check in, stays STOCK. The box always
                              boots on stock, so a bad profile is masked over ssh, never a brick.
  A box still on the OLD 170hx-oc.service model is migrated automatically the next time you run
  '170tune install' - see SETUP above. There is no manual migration step.

PROFILES (applied by 170hx-oc, which 'apply' calls)
  stock     +0   / no lock    184.3 TF @ 199.2 W    baseline
  dense     +250 / 1200       160.8 TF @ 120.2 W    most cards per PSU
  eff       +300 / 1350       180.8 TF @ 131.2 W    default: near-stock speed, a third less power
  match     +250 / 1400       186.5 TF @ 142.2 W    exactly stock throughput, much less power
  balanced  +300 / 1470       196.2 TF @ 149.7 W    more throughput, still under 150 W
  perf      +350 / 1590       212.2 TF @ 181.2 W    throughput first, still under stock power
  max       +350 / 1650       215.3 TF @ 186.1 W    peak validated throughput

  The numbers above are the REFERENCE card, serial 1322621047793. Per-card silicon varies: gate
  the point on your own card and persist that ('qualify' recommends one, 'persist save
  --offset/--clk' adopts it). 'apply' changes the running card only; 'persist' is the deliberate
  second step that puts it in the boot path, and it will not do so for a point this card has not
  gated.

ENVIRONMENT
  GATE_TEMP=60          HBM temperature to soak to before every sweep. Gating a cold card is
                        the classic way to bless a setting that fails in service.
  GATE_SOAK_MAX=180     give up soaking after this long
  GATE_COMPUTE=45       seconds of bit-exact GEMM checking per gate (0 disables)
  MEASURE_TIMEOUT=180   a measurement that exceeds this is treated as a HANG
  WORKLOAD_TIMEOUT=900  'gate --workload': a workload that hangs counts as a FAILURE
  CTX_TIMEOUT=60        context probe timeout; a probe that hangs is treated as a wedge
  CTXPROBE=/path        the context probe (default: the ctx_probe installed here)
  BENCH=/path           the SM integrity sweep (default: the 170hx-sweep installed here)
  COMPUTE=/path         the compute checker        NVML=/path   nvml_oc
  MCLK_GATE_SOAK_MAX=360  soak budget for mclk-gate/mclk-ladder (mclk rungs cool faster)
  MCLK_TUNE=1            apply the per-NDIV timing tune during mclk-gate/ladder (extends 76->77)
  MCLK_RECAL=1           opt in to the DDLL eye recal (non-deterministic; off by default)

EXIT CODES
  0 success / gated       1 rejected, faulted, or failed       2 usage error or hang

TYPICAL SESSION (new card/box)
  sudo 170tune install
  sudo 170tune preflight
  sudo 170tune snapshot-stock
  170tune explain
  170tune explain-hbm
  sudo 170tune selftest
  sudo 170tune ladder 1400
  sudo 170tune gate 200 1400 4 --workload <your workload>
  sudo 170tune persist save --offset 200 --clk 1400
  sudo 170tune persist enable
  sudo 170tune mclk-gate 76 12
  sudo 170tune persist save --ndiv 76
  sudo 170tune persist enable
EOF
}

# ---- per-card stock override --------------------------------------------------------------
# 'snapshot-stock' (above) writes a live-read snapshot per serial. Load it here, over the
# hardcoded STOCK_* defaults near the top of this file, so a card whose real stock differs
# from the one those defaults were measured on gets its OWN revert target. No card present, or
# no snapshot taken yet -> serial is empty or the file is missing -> the hardcoded defaults
# stand, unchanged. Must not error on a box with no card.
_stock_serial=$(serial 2>/dev/null)
if [ -n "$_stock_serial" ] && [ -f "$STATE/stock/$_stock_serial.conf" ]; then
    # shellcheck disable=SC1090
    . "$STATE/stock/$_stock_serial.conf"
fi
unset _stock_serial

case "${1:-}" in
    -h|--help|help) cmd_help ;;
    explain)     cmd_explain ;;
    explain-hbm) cmd_explain_hbm ;;
    status)     cmd_status ;;
    try)        shift; need_root try "$@"; cmd_try "$@" ;;
    gate)       shift; need_root gate "$@"; cmd_gate "$@" ;;
    ladder)     shift; need_root ladder "$@"; cmd_ladder "$@" ;;
    qualify)    shift; need_root qualify "$@"; cmd_qualify "$@" ;;
    apply)      shift; need_root apply "$@"; exec "$OCAPPLY" "${1:?profile}" ;;
    reset)      need_root reset; exec "$OCAPPLY" stock ;;
    quarantine)   shift; cmd_quarantine "$@" ;;
    unquarantine) shift; cmd_unquarantine "$@" ;;
    selftest)   shift; need_root selftest "$@"; cmd_selftest "$@" ;;
    recover)    shift; cmd_recover "$@" ;;
    boot-check) shift; cmd_boot_check "$@" ;;
    mclk-status) shift; [ -x "$HBM_MCLK" ] || die "hbm_mclk not found at $HBM_MCLK"; need_root mclk-status; "$HBM_MCLK" get ;;
    mclk-try)    shift; need_root mclk-try "$@"; cmd_mclk_try "$@" ;;
    mclk-gate)   shift; need_root mclk-gate "$@"; cmd_mclk_gate "$@" ;;
    mclk-ladder) shift; need_root mclk-ladder "$@"; cmd_mclk_ladder "$@" ;;
    hbm-matrix)  shift; need_root hbm-matrix "$@"; cmd_hbm_matrix "$@" ;;
    refresh)      shift; need_root refresh "$@"; cmd_refresh "$@" ;;
    timings)      shift; need_root timings "$@"; cmd_timings "$@" ;;
    timings-gate) shift; need_root timings-gate "$@"; cmd_timings_gate "$@" ;;
    timings-tune)  shift; need_root timings-tune "$@"; hbm_timing_tune "${1:?usage: timings-tune <NDIV>}"; say "applied timing tune for NDIV ${1}" ;;
    timings-stock) shift; need_root timings-stock; hbm_timing_stock; say "restored stock timings" ;;
    hbm-profile)   shift; hbm_timing_profile "${1:?usage: hbm-profile <NDIV>}"; echo ;;
    persist)     shift; cmd_persist "$@" ;;
    boot-apply)  shift; cmd_boot_apply "$@" ;;
    install)         shift; need_root install "$@"; cmd_install "$@" ;;
    preflight)        shift; cmd_preflight "$@" ;;
    snapshot-stock)   shift; need_root snapshot-stock "$@"; cmd_snapshot_stock "$@" ;;
    *) cmd_help; exit 2 ;;
esac
