[Unit]
Description=CMP 170HX clock-offset + power-limit profile (persisted by 170tune)
Documentation=file:///usr/share/doc/170tune/tuning-guide.md
After=nvidia-persistenced.service gen2-hammer.service 170tune-bootcheck.service
Wants=nvidia-persistenced.service
ConditionPathExists=/usr/local/bin/nvml_oc
# No persisted profile means the card comes up stock. '170tune persist <profile>' writes this
# file, '170tune persist off' removes it. The unit stays inert until then, even when enabled.
ConditionPathExists=/etc/170tune/profile

[Service]
Type=oneshot
RemainAfterExit=yes
# Offsets are volatile: they are lost on every driver reload / reboot, so re-apply at boot.
# PROFILE - and OC_OFFSET/OC_CLK for a per-card 'custom' point - come from the file below, so the
# persisted profile can be changed through 170tune without hand-editing a unit.
EnvironmentFile=/etc/170tune/profile
ExecStart=/usr/local/bin/170hx-oc $PROFILE
ExecStop=/usr/local/bin/170hx-oc stock

[Install]
WantedBy=multi-user.target
